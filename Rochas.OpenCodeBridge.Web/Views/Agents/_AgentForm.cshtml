@* Form de agente (partial). *@
@model Rochas.OpenCodeBridge.Web.Models.Agent
<input type="hidden" name="Id" value="@Model.Id" />
<div class="mb-2"><label class="form-label">Nome</label><input name="Name" class="form-control" value="@Model.Name" /></div>
<div class="row"><div class="col-12 col-md-6"><div class="mb-2"><label class="form-label">Model (ex. qwen3.5-9b)</label><input name="Model" class="form-control" value="@Model.Model" /></div></div>
<div class="col-12 col-md-6"><div class="mb-2"><label class="form-label">Bridge URL</label><input name="BridgeUrl" class="form-control" value="@Model.BridgeUrl" /></div></div></div>
<div class="row"><div class="col-12 col-md-4"><div class="mb-2"><label class="form-label">Modo de atuação</label>
<select name="Mode" class="form-select">
  <option value="Build" selected="@(!string.Equals(Model.Mode, "plan", System.StringComparison.OrdinalIgnoreCase))">Build (execução total)</option>
  <option value="Plan" selected="@(string.Equals(Model.Mode, "plan", System.StringComparison.OrdinalIgnoreCase))">Plan (leitura/navegação)</option>
</select></div></div>
<div class="col-12 col-md-4"><div class="mb-2"><label class="form-label">Criatividade (<span class="criat-lbl"></span>)</label>
<input type="range" class="form-range criat-range" min="0" max="2" step="1" />
<input type="hidden" name="Temperature" class="criat-val" value="@Model.Temperature" /></div></div>
<div class="col-12 col-md-4"><div class="mb-2"><label class="form-label">Raciocínio</label>
<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="Thinking" value="events" @(string.Equals(Model.Thinking, "events", System.StringComparison.OrdinalIgnoreCase) ? "checked" : "") /><label class="form-check-label">Exibir thinking</label></div></div></div>
</div>
<script>
(function () {
  // Slider Criatividade: Baixa 0.1 / Média 0.3 / Alta 0.5 (só UI; grava o float).
  if (window._agentCriat) return; window._agentCriat = true;
  var vals = [0.1, 0.3, 0.5], names = ['Baixa', 'Média', 'Alta'];
  function setup(range) {
    var wrap = range.closest('.row') || document;
    var hidden = wrap.querySelector('.criat-val');
    var lbl = wrap.querySelector('.criat-lbl');
    var cur = parseFloat(String((hidden && hidden.value) || '').replace(',', '.'));
    if (isNaN(cur)) cur = 0.3;
    var idx = 0, bd = 1e9;
    vals.forEach(function (v, i) { var d = Math.abs(v - cur); if (d < bd) { bd = d; idx = i; } });
    function paint() {
      var i = +range.value;
      if (hidden) hidden.value = vals[i];
      if (lbl) lbl.textContent = names[i] + ' ' + vals[i];
    }
    range.value = idx; paint();
    range.addEventListener('input', paint);
  }
  function bindAll() { document.querySelectorAll('.criat-range').forEach(setup); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindAll);
  else bindAll();
})();
</script>
<div class="mb-2"><label class="form-label">Instruções a seguir</label>
<textarea name="SystemPrompt" class="form-control" rows="6" placeholder="Orquestrador: como decompor; executor: enunciado rígido">@Model.SystemPrompt</textarea></div>
<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="Active" value="true" @(Model.Active ? "checked" : "") /><label class="form-check-label">Ativo</label></div>
@{
  var toolSet = new HashSet<string>((Model.Tools ?? "").Split(',', System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries), System.StringComparer.OrdinalIgnoreCase);
  bool has(string n) => toolSet.Contains(n);
}
<div class="mb-2"><label class="form-label">Tools liberadas (vazio = nenhuma)</label>
@Html.AntiForgeryToken()
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="glob" @(has("glob") ? "checked" : "") /><label class="form-check-label">Navegação de pastas (glob)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="read" @(has("read") ? "checked" : "") /><label class="form-check-label">Leitura de arquivos (read, grep)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="git" @(has("git") ? "checked" : "") /><label class="form-check-label">Manipulação de repositórios (git)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="fetch" @(has("fetch") ? "checked" : "") /><label class="form-check-label">Navegação na internet (fetch)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="display" @(has("display") ? "checked" : "") /><label class="form-check-label">Exibição em console (echo, cat)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="write" @(has("write") ? "checked" : "") /><label class="form-check-label">Escrita em arquivos (write, edit)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="proc" @(has("proc") ? "checked" : "") /><label class="form-check-label">Visualização de processos (ps, top)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="shell" @(has("shell") ? "checked" : "") /><label class="form-check-label">Validação de scripts (shell)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="exec" @(has("exec") ? "checked" : "") /><label class="form-check-label">Execução de scripts (bash, sh)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="install" @(has("install") ? "checked" : "") /><label class="form-check-label">Instalar pacotes (pip, apt)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="selectedTools" value="subagent" @(has("subagent") ? "checked" : "") /><label class="form-check-label">Delegação a subagentes (subagent)</label></div>
</div>
<script>
(function () {
  // Plan nunca escreve, valida nem executa: vêm inativas (fetch navega, proc só lê: ficam).
  if (window._agentModeLock) return; window._agentModeLock = true;
  function applyMode(sel) {
    const scope = (sel.closest && sel.closest('form')) || document;
    const isPlan = ((sel.value || '').toLowerCase() === 'plan');
    ['write', 'shell', 'exec', 'install'].forEach(function (v) {
      scope.querySelectorAll('input[name="selectedTools"][value="' + v + '"]').forEach(function (cb) {
        if (isPlan) { cb.checked = false; cb.disabled = true; }
        else { cb.disabled = false; }
      });
    });
  }
  function bindAll() {
    document.querySelectorAll('select[name="Mode"]').forEach(function (sel) {
      applyMode(sel);
      sel.addEventListener('change', function () { applyMode(sel); });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindAll);
  else bindAll();
})();
</script>
