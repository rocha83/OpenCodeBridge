@model IEnumerable<Rochas.OpenCodeBridge.Web.Models.Agent>
@{ Layout = "_Layout"; ViewData["Title"] = "Agentes"; }
@{ var isAdmin = (User.FindFirst("IsAdmin")?.Value ?? "false").ToLower() == "true"; }
<h5>Agentes @if (isAdmin) { <a class="btn btn-sm btn-primary" href="/Agents/Create">Novo</a> }</h5>
<table class="table table-dark table-striped">
<tr><th>Nome</th><th>Model</th><th>Bridge</th><th>Papel</th><th>Modo</th><th>Temp</th><th>Thinking</th><th>Tools</th><th>Ativo</th><th></th></tr>
@foreach (var a in Model) {
<tr><td>@a.Name</td><td>@a.Model</td><td>@a.BridgeUrl</td><td>@(string.IsNullOrEmpty(a.Role) ? "—" : a.Role)</td><td>@(string.IsNullOrEmpty(a.Mode) ? "build" : a.Mode)</td><td>@a.Temperature</td><td>@a.Thinking</td><td class="small text-muted">@a.Tools</td><td>@(a.Active ? "sim" : "não")</td>
<td>@if (isAdmin) { <a class="btn btn-sm btn-outline-secondary" href="/Agents/Edit/@a.Id">Editar</a>
<a class="btn btn-sm btn-outline-danger" href="/Agents/Delete/@a.Id">Excluir</a> } else { <span class="small text-muted">sistema</span> }</td></tr>
}
</table>

