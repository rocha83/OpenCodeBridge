@model IEnumerable<Rochas.OpenCodeBridge.Web.Models.Agent>
@{ Layout = "_Layout"; ViewData["Title"] = "Agentes"; }
@{ var isAdmin = (User.FindFirst("IsAdmin")?.Value ?? "false").ToLower() == "true"; }
<div class="card mb-3">
  <div class="card-body">
    <form method="get" action="/Agents" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1" for="q">Critério (nome ou system prompt)</label>
        <input id="q" name="criterio" class="form-control form-control-sm" value="@ViewBag.Criterio" placeholder="ex.: scripter, shell bash..." />
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1" for="f-model">Model</label>
        <select id="f-model" name="model" class="form-select form-select-sm">
          <option value="">Todos</option>
          @foreach (var m in (System.Collections.IEnumerable)ViewBag.Models) {
          <option value="@m" @(((string[])ViewBag.SelModels).Contains((string)m) ? "selected" : null)>@m</option>
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1" for="f-mode">Mode</label>
        <select id="f-mode" name="mode" class="form-select form-select-sm">
          <option value="">Todos</option>
          @foreach (var m in (System.Collections.IEnumerable)ViewBag.Modes) {
          <option value="@m" @(((string[])ViewBag.SelModes).Contains((string)m) ? "selected" : null)>@m</option>
          }
        </select>
      </div>
      <div class="col-md-2">
        <div class="form-check mt-4">
          <input class="form-check-input" type="checkbox" name="thinking" value="events" id="f-think" @(ViewBag.ThinkingOn ? "checked" : null) />
          <label class="form-check-label small" for="f-think" title="Marcado: só com raciocínio (events)">Raciocínio</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="active" value="1" id="f-active" @(ViewBag.ActiveOn ? "checked" : null) />
          <label class="form-check-label small" for="f-active" title="Marcado: só ativos">Ativo</label>
        </div>
      </div>
      <div class="col-md-2">
        <div class="row g-2">
          <div class="col-12 d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-sm btn-info">Buscar</button>
            <a href="/Agents" class="btn btn-sm btn-outline-secondary">Limpar</a>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center p-3">
    <p class="fw-bold mb-0">Agentes</p>
    <div>
      <span class="small text-muted me-2">@Model.Count() de @ViewBag.Total cadastrados</span>
      @if (isAdmin) { <button class="btn btn-sm btn-info" data-mdb-toggle="modal" data-mdb-target="#agentModal-new">Novo agente</button> }
    </div>
  </div>
  <div class="list-group list-group-flush crud-list">
    @foreach (var a in Model) {
    <div class="list-group-item">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div>
          <span class="fw-bold">@a.Name</span>
          <span class="badge bg-info ms-2">@(string.IsNullOrEmpty(a.Mode) ? "Build" : a.Mode)</span>
          @if (a.Active) { <span class="badge bg-success ms-1">ativo</span> } else { <span class="badge bg-warning ms-1">inativo</span> }
          <div class="small text-muted mt-1">@a.Model · @a.BridgeUrl · temp @a.Temperature · @a.Thinking</div>
          <div class="small text-muted">@a.Tools</div>
        </div>
        <div class="btn-group btn-group-sm flex-shrink-0">
          @if (isAdmin) {
          <button class="btn btn-outline-secondary" data-mdb-toggle="modal" data-mdb-target="#agentModal-@a.Id">Editar</button>
          <a class="btn btn-outline-danger" href="/Agents/Delete/@a.Id" onclick="return confirm('Excluir @a.Name?')">Excluir</a>
          } else { <span class="small text-muted">sistema</span> }
        </div>
      </div>
    </div>
    }
  </div>
</div>
@if (isAdmin) {
  <div class="modal fade" id="agentModal-new" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-md-down">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title mb-0">Novo agente</h6>
          <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form method="post" action="/Agents/Create">
          <div class="modal-body crud-form">@await Html.PartialAsync("_AgentForm", (Rochas.OpenCodeBridge.Web.Models.Agent)ViewBag.NewAgent)</div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-mdb-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-info">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  @foreach (var a in Model) {
  <div class="modal fade" id="agentModal-@a.Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-md-down">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title mb-0">Editar agente</h6>
          <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form method="post" action="/Agents/Edit">
          <div class="modal-body crud-form">@await Html.PartialAsync("_AgentForm", a)</div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-mdb-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-info">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  }
}
