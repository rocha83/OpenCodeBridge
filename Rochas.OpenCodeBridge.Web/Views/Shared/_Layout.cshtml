<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Bridge Web</title>
<link href="~/lib/mdb/mdb.min.css" rel="stylesheet" />
<link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
<link href="~/css/black.css" rel="stylesheet" />
<script>
  (function() {
    var theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-bs-theme', theme);
  })();
</script>
</head>
<body>
<nav class="navbar navbar-expand navbar-dark topbar">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">bridge.web</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <div class="navbar-nav">
        <a class="nav-link" href="/Chat">Chat</a>
        @if ((User.FindFirst("IsAdmin")?.Value ?? "false").ToLower() == "true")
        {
          <a class="nav-link" href="/Agents">Agentes</a>
          <a class="nav-link" href="/Users">Usuários</a>
        }
      </div>
      <form method="post" action="/Account/Logout" class="d-flex align-items-center">
        <span class="navbar-text me-2">@User.Identity.Name</span>
        <button type="button" class="btn btn-sm btn-outline-secondary me-2" id="themeToggle" title="Alternar tema">
          <i class="fas fa-sun"></i>
        </button>
        <button class="btn btn-sm btn-outline-secondary">Sair</button>
      </form>
    }
  </div>
</nav>
<main class="container-fluid py-3">@RenderBody()</main>
<script src="~/lib/mdb/mdb.min.js"></script>
<script>
  document.getElementById('themeToggle')?.addEventListener('click', function() {
    var html = document.documentElement;
    var theme = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-bs-theme', theme);
    localStorage.setItem('theme', theme);
    this.innerHTML = theme === 'dark' ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
  });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

