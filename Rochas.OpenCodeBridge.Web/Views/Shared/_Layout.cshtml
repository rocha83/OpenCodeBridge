<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Bridge Web</title>
<link href="https://cdn.jsdelivr.net/npm/mdb-ui-kit@6.4.2/css/mdb.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
<link href="~/css/black.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark topbar">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">bridge.web</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <div class="navbar-nav">
        <a class="nav-link" href="/Chat">Chat</a>
        <a class="nav-link" href="/Agents">Agentes</a>
        <a class="nav-link" href="/Users">Usuários</a>
      </div>
      <form method="post" action="/Account/Logout" class="d-flex">
        <span class="navbar-text me-2">@User.Identity.Name</span>
        <button class="btn btn-sm btn-outline-secondary">Sair</button>
      </form>
    }
  </div>
</nav>
<main class="container-fluid py-3">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/mdb-ui-kit@6.4.2/js/mdb.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

