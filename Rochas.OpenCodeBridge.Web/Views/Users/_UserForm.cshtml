@* Form de usuário (partial). *@
@model Rochas.OpenCodeBridge.Web.Models.User
<form method="post" action="@(ViewData["FormAction"] ?? "")">
  @Html.AntiForgeryToken()
  <div class="mb-2"><label class="form-label">Nome</label><input name="Name" class="form-control" value="@Model.Name" /></div>
  <div class="mb-2"><label class="form-label">Email</label><input name="Email" class="form-control" value="@Model.Email" /></div>
  <div class="mb-2"><label class="form-label">Senha</label><input name="password" type="password" class="form-control" /></div>
  <button class="btn btn-info">Salvar</button>
</form>

