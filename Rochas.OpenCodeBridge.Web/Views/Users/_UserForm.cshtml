@* Form de usuário (partial). *@
@model Rochas.OpenCodeBridge.Web.Models.User
<form method="post" action="@(ViewData["FormAction"] ?? "")">
  @Html.AntiForgeryToken()
  <div class="mb-2"><label class="form-label">Nome</label><input name="Name" class="form-control" value="@Model.Name" /></div>
  <div class="mb-2"><label class="form-label">Email</label><input name="Email" class="form-control" value="@Model.Email" /></div>
  <div class="mb-2"><label class="form-label">Senha @(Model.Id is null ? "" : "(em branco = mantém)")</label><input name="password" type="password" class="form-control" autocomplete="new-password" /></div>
  <div class="row g-2 mb-2">
    <div class="col-6">
      <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" name="Active" value="true" id="u-active-@(Model.Id ?? 0)" @(Model.Active || Model.Id is null ? "checked" : null) />
        <label class="form-check-label small" for="u-active-@(Model.Id ?? 0)">Ativo</label>
      </div>
    </div>
    <div class="col-6">
      <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" name="IsAdmin" value="true" id="u-admin-@(Model.Id ?? 0)" @(Model.IsAdmin ? "checked" : null) />
        <label class="form-check-label small" for="u-admin-@(Model.Id ?? 0)">Admin</label>
      </div>
    </div>
  </div>
  <button class="btn btn-info">Salvar</button>
</form>
