@model IEnumerable<Rochas.OpenCodeBridge.Web.Models.User>
@{ Layout = "_Layout"; ViewData["Title"] = "Usuários"; ViewData["FormAction"] = "/Users/Create"; }
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center p-3">
    <p class="fw-bold mb-0">Usuários</p>
    <div>
      <span class="small text-muted me-2">@Model.Count() cadastrados</span>
      <button class="btn btn-sm btn-info" data-mdb-toggle="modal" data-mdb-target="#userModal-new">Novo usuário</button>
    </div>
  </div>
  <div class="list-group list-group-flush crud-list">
    @foreach (var u in Model) {
    <div class="list-group-item">
      <div class="d-flex justify-content-between align-items-center gap-2">
        <div>
          <span class="fw-bold">@u.Name</span>
          @if (u.Active) { <span class="badge bg-success ms-2">ativo</span> } else { <span class="badge bg-warning ms-2">inativo</span> }
          <div class="small text-muted mt-1">@u.Email</div>
        </div>
        <div class="btn-group btn-group-sm flex-shrink-0">
          <form method="post" action="/Users/Toggle/@u.Id" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">Ativar/Desativar</button></form>
          <form method="post" action="/Users/Delete/@u.Id" class="d-inline" onsubmit="return confirm('Excluir @u.Email?')">@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Excluir</button></form>
        </div>
      </div>
    </div>
    }
  </div>
</div>
<div class="modal fade" id="userModal-new" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title mb-0">Novo usuário</h6>
        <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body crud-form">@await Html.PartialAsync("_UserForm", new Rochas.OpenCodeBridge.Web.Models.User())</div>
    </div>
  </div>
</div>
