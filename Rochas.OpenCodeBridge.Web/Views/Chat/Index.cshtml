@{ Layout = "_Layout"; ViewData["Title"] = "Chat"; }
@{
    var agents = (IEnumerable<Rochas.OpenCodeBridge.Web.Models.Agent>)ViewBag.Agents;
}
<section>
  <div class="container py-5">

    <div class="row">

      <div class="col-md-6 col-lg-5 col-xl-4 mb-4 mb-md-0">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Sessões</h5>
          <div>
            <button type="button" class="btn btn-sm btn-info me-2" id="newSession" data-mdb-button-init data-mdb-ripple-init>Nova</button>
            <button type="button" class="btn btn-sm btn-outline-danger" id="clearSessions" data-mdb-button-init data-mdb-ripple-init>Limpar</button>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <ul class="list-unstyled mb-0" id="sessionList"></ul>
          </div>
        </div>

      </div>

      <div class="col-md-6 col-lg-7 col-xl-8">

        <div class="mb-4">
          <select id="agentId" class="form-select form-select-sm">
            @foreach (var a in agents)
            {
              <option value="@a.Id">@a.Name — @a.Model</option>
            }
          </select>
          <div class="small text-muted mt-2"><span id="engineDot" class="dot"></span> <span id="engineTxt">Aguardando...</span></div>
        </div>

        <ul class="list-unstyled" id="conv" aria-live="polite" aria-atomic="false"></ul>

        <ul class="list-unstyled">
          <li class="mb-3">
            <label class="form-label fw-bold text-white" for="prompt">Pergunta ou Instrução</label>
            <div data-mdb-input-init class="form-outline mb-3">
              <textarea class="form-control bg-body-tertiary rounded-3" id="prompt" rows="4" style="border: 1px solid #2a323d !important;"></textarea>
            </div>
          </li>
          <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-info btn-rounded float-end" id="send">ENVIAR</button>
        </ul>

      </div>

    </div>

  </div>
</section>
<!-- MDB Toast container for errors -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;" id="toastContainer"></div>
@section Scripts {
<script>
const conv = document.getElementById('conv');
const sessionList = document.getElementById('sessionList');
const agentSel = document.getElementById('agentId');
const engineDot = document.getElementById('engineDot');
const engineTxt = document.getElementById('engineTxt');
const toastContainer = document.getElementById('toastContainer');
let currentSessionId = null;
let currentAgentId = null;

const avatarUser = '<span class="rounded-circle d-flex align-self-start ms-3 shadow-1-strong bg-secondary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-user fa-2x text-white"></i></span>';
const avatarAgent = '<span class="rounded-circle d-flex align-self-start me-3 shadow-1-strong bg-primary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-robot fa-2x text-white"></i></span>';

function esc(s) { return (s || '').replace(/</g, '<'); }

function showToast(message, type = 'danger') {
  const id = 'toast-' + Date.now();
  const bg = type === 'danger' ? 'bg-danger' : (type === 'success' ? 'bg-success' : 'bg-info');
  const icon = type === 'danger' ? 'fa-circle-exclamation' : (type === 'success' ? 'fa-circle-check' : 'fa-circle-info');
  const toastHtml = `
    <div id="${id}" class="toast ${bg} text-white" role="alert" aria-live="assertive" aria-atomic="true" data-mdb-delay="5000">
      <div class="toast-header ${bg} text-white border-0">
        <i class="fas ${icon} me-2"></i>
        <strong class="me-auto">Bridge Web</strong>
        <button type="button" class="btn-close btn-close-white" data-mdb-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body">${esc(message)}</div>
    </div>`;
  toastContainer.insertAdjacentHTML('beforeend', toastHtml);
  const toastEl = document.getElementById(id);
  if (toastEl) {
    const toast = new mdb.Toast(toastEl);
    toast.show();
    toastEl.addEventListener('hidden.mdb.toast', () => toastEl.remove());
  }
}

function isScrolledToBottom() {
  return conv.scrollTop + conv.clientHeight >= conv.scrollHeight - 50;
}

// Linha de status de tool: "Executando [nome]..." piscando -> "[nome] executado."
function toolStatus(name, running, ok) {
  if (running) {
    const li = document.createElement('li');
    li.className = 'd-flex justify-content-start mt-1 mb-1 tool-status';
    li.dataset.tool = name;
    li.innerHTML = `<span class="small text-muted"><span class="dot blink me-1"></span>Executando ${esc(name)}...</span>`;
    conv.appendChild(li);
  } else {
    const items = conv.querySelectorAll('.tool-status');
    let li = null;
    items.forEach(el => { if (el.dataset.tool === name) li = el; });
    if (li) {
      li.innerHTML = `<span class="small text-muted">${esc(name)} ${ok === false ? 'falhou.' : 'executado.'}</span>`;
      li.classList.remove('tool-status');
    }
  }
  if (isScrolledToBottom()) scrollToBottom();
}

function scrollToBottom() {
  conv.scrollTo({ top: conv.scrollHeight, behavior: 'smooth' });
}

async function loadSessions() {
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  sessionList.innerHTML = '';
  list.forEach(s => {
    const li = document.createElement('li');
    li.className = 'p-2 border-bottom' + (s.id === currentSessionId ? ' bg-body-tertiary' : '');
    const updated = new Date(s.updatedAt).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    li.innerHTML = `<a href="#!" class="d-flex justify-content-between text-decoration-none">
      <div class="d-flex flex-row">
        <span class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-info justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-comments fa-2x text-white"></i></span>
        <div class="pt-1">
          <p class="fw-bold mb-0 text-truncate" style="max-width:200px">${esc(s.title)}</p>
          <p class="small text-muted mb-0">${updated}</p>
        </div>
      </div>
    </a>`;
    li.querySelector('a').onclick = (e) => { e.preventDefault(); selectSession(s.id, s.agentId); };
    sessionList.appendChild(li);
  });
}

async function selectSession(id, agentId) {
  currentSessionId = id;
  currentAgentId = agentId;
  agentSel.value = agentId;
  await loadMessages(id);
  await loadSessions();
  checkEngine();
}

async function loadMessages(sessionId) {
  const r = await fetch(`/Chat/Sessions/${sessionId}/Messages`);
  const msgs = await r.json();
  const wasAtBottom = isScrolledToBottom();
  conv.innerHTML = '';
  msgs.forEach(m => conv.appendChild(msgItem(m.role, m.thinking, m.content)));
  if (wasAtBottom) scrollToBottom();
}

async function createSession() {
  const r = await fetch('/Chat/Sessions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ agentId: +agentSel.value, title: 'Nova sessão' })
  });
  const s = await r.json();
  currentSessionId = s.id;
  currentAgentId = s.agentId;
  agentSel.value = s.agentId;
  await loadSessions();
  conv.innerHTML = '';
}

async function deleteAllSessions() {
  if (!confirm('Excluir todas as sessões?')) return;
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  for (const s of list) {
    await fetch(`/Chat/Sessions/${s.id}`, { method: 'DELETE' });
  }
  currentSessionId = null;
  currentAgentId = null;
  await loadSessions();
  conv.innerHTML = '';
}

function msgItem(role, think, body) {
  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  if (role === 'user') {
    li.innerHTML = `
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Você</p>
        </div>
        <div class="card-body"><p class="mb-0 text-wrap">${esc(body)}</p></div>
      </div>
      ${avatarUser}`;
  } else {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          <p class="mb-0 ans text-wrap">${esc(body)}</p>
        </div>
      </div>`;
  }
  return li;
}

agentSel.onchange = () => { currentAgentId = +agentSel.value; checkEngine(); };

async function checkEngine() {
  try {
    const r = await fetch(`/Chat/Ping?agentId=${agentSel.value}`);
    const j = await r.json();
    engineDot.className = 'dot' + (j.ok ? '' : ' err');
    engineTxt.textContent = j.ok ? 'Concluído!' : 'Desconectado';
  } catch { engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado'; }
}

document.getElementById('newSession').onclick = createSession;

const promptEl = document.getElementById('prompt');
promptEl.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    document.getElementById('send').click();
  }
});

promptEl.addEventListener('blur', () => {
  // Opcional: re-focar após envio (feito no send.onclick)
});

document.getElementById('send').onclick = async () => {
  const ta = document.getElementById('prompt');
  if (!ta.value.trim()) return;
  if (!currentSessionId) {
    // Se não há sessão, tenta criar uma
    await createSession();
    if (!currentSessionId) {
      showToast('Nenhuma sessão disponível. Recarregue a página.', 'warning');
      return;
    }
  }
  const text = ta.value; ta.value = '';
  
  // Disable input and button during processing
  ta.disabled = true;
  sendBtn.disabled = true;
  sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando...';

  // Add Cancel button
  const cancelBtn = document.createElement('button');
  cancelBtn.type = 'button';
  cancelBtn.className = 'btn btn-sm btn-outline-danger ms-2';
  cancelBtn.id = 'cancelBtn';
  cancelBtn.innerHTML = '<i class="fas fa-times me-1"></i>Cancelar';
  cancelBtn.style.display = 'none';
  sendBtn.parentNode.insertBefore(cancelBtn, sendBtn.nextSibling);
  
  // AbortController for cancellation
  const abortController = new AbortController();
  cancelBtn.style.display = 'inline-block';
  cancelBtn.onclick = () => {
    abortController.abort();
    cancelBtn.style.display = 'none';
    document.getElementById('processing-indicator')?.remove();
    stopTypewriter();
  };
  
  ta.focus();

  // Adiciona mensagem do usuário na UI imediatamente
  conv.appendChild(msgItem('user', '', esc(text)));

  // Indicador "Processando" como linha da conversa (com margem), ativo até finalizar
  const indicator = document.createElement('li');
  indicator.id = 'processing-indicator';
  indicator.className = 'd-flex justify-content-end mt-2 mb-3';
  indicator.innerHTML = '<span class="small text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Processando...</span>';
  conv.appendChild(indicator);
  if (isScrolledToBottom()) scrollToBottom();

  // Prepara bolha do agente (cria no primeiro content; thinking vai em accordion ao final)
  let agentLi = null;
  let anP = null;
  let think = '';
  let full = '';
  let agentBubbleCreated = false;

  // Efeito "digitando" palavra por palavra (JS puro)
  let shownWords = 0;
  let typeTimer = null;
  function renderWords() {
    if (!anP) return;
    const parts = full.split(/(\s+)/);
    shownWords = Math.min(shownWords, parts.length);
    anP.textContent = parts.slice(0, shownWords).join('');
  }
  function drainWords() {
    if (!anP) return;
    const total = full.split(/(\s+)/).length;
    const backlog = total - shownWords;
    if (backlog <= 0) return;
    // Ritmo legível (~20 palavras/s); acelera só sob grande acúmulo
    shownWords += backlog > 100 ? 10 : backlog > 40 ? 5 : 2;
    renderWords();
  }
  function startTypewriter() {
    if (typeTimer) return;
    if (anP) anP.classList.add('typing');
    typeTimer = setInterval(drainWords, 90);
  }
  function stopTypewriter() {
    if (typeTimer) { clearInterval(typeTimer); typeTimer = null; }
    if (anP) { shownWords = full.split(/(\s+)/).length; renderWords(); anP.classList.remove('typing'); }
  }

  engineDot.className = 'dot blink'; engineTxt.textContent = 'Pensando...';

  try {
    const res = await fetch('/Chat/Stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: currentSessionId, agentId: currentAgentId, messages: [{ role: 'user', content: text }] }), signal: abortController.signal
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    
    // Re-enable input/button immediately after successful request start
    // (o "Processando" permanece até o fim do stream)
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    document.getElementById('cancelBtn')?.remove();
    ta.focus();

    const reader = res.body.getReader(), dec = new TextDecoder();
    let buf = '';
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      const parts = buf.split('\n\n'); buf = parts.pop();
      for (const p of parts) {
        const line = p.split('\n').find(l => l.startsWith('data:'));
        if (!line || line.includes('[DONE]')) continue;
        try {
          const evt = JSON.parse(line.slice(5));
          if (evt.progress) {
            // Progresso de tool vindo do servidor
            if (evt.progress === 'tool_start') toolStatus(evt.name, true);
            else if (evt.progress === 'tool_done') toolStatus(evt.name, false, evt.ok);
            continue;
          }
          const d = evt.choices[0].delta;
          if (d.reasoning_content) {
            // Thinking acumula silencioso; vai pronto em accordion fechado ao final
            think += d.reasoning_content;
            engineTxt.textContent = 'Pensando...';
          }
          else if (d.content) {
            if (!agentBubbleCreated) {
              // Cria a bolha na primeira content (sem thinking ao vivo)
              agentLi = document.createElement('li');
              agentLi.className = 'd-flex justify-content-between mb-4';
              agentLi.innerHTML = `
                ${avatarAgent}
                <div class="card w-100">
                  <div class="card-header d-flex justify-content-between p-3">
                    <p class="fw-bold mb-0">Agente</p>
                  </div>
                  <div class="card-body">
                    <p class="mb-0 ans text-wrap"></p>
                  </div>
                </div>`;
              conv.appendChild(agentLi);
              anP = agentLi.querySelector('.ans');
              agentBubbleCreated = true;
            }
            full += d.content;
            startTypewriter();
          }
        } catch (e) { /* chunk parcial: ignora */ }
      }
      if (isScrolledToBottom()) scrollToBottom();
    }
  } catch (e) {
    if (!agentBubbleCreated) {
      // Cria bolha de erro se nem começou
      agentLi = document.createElement('li');
      agentLi.className = 'd-flex justify-content-between mb-4';
      agentLi.innerHTML = `${avatarAgent}<div class="card w-100"><div class="card-body"><p class="mb-0 ans text-danger">Erro: ${esc(e.message)}</p></div></div>`;
      conv.appendChild(agentLi);
    } else {
      anP.textContent = 'Erro: ' + e.message;
    }
    engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado';
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    stopTypewriter();
    document.getElementById('processing-indicator')?.remove();
    document.getElementById('cancelBtn')?.remove();
    showToast('Erro ao conectar na engine. Verifique se a bridge está online.', 'danger');
  }
  if (agentBubbleCreated) {
    // Flush final do efeito + accordion de thinking fechado + remove "Processando"
    stopTypewriter();
    if (think.trim() && anP) {
      const det = document.createElement('details');
      det.className = 'mb-2';
      const sum = document.createElement('summary');
      sum.className = 'small text-muted';
      sum.textContent = 'Raciocínio';
      const p = document.createElement('p');
      p.className = 'small text-muted';
      p.textContent = think;
      det.appendChild(sum);
      det.appendChild(p);
      anP.parentNode.insertBefore(det, anP);
    }
    document.getElementById('processing-indicator')?.remove();
    engineDot.className = 'dot'; engineTxt.textContent = 'Concluído!';
    document.getElementById('cancelBtn')?.remove();
  } else {
    document.getElementById('processing-indicator')?.remove();
  }
  if (isScrolledToBottom()) scrollToBottom();
};

// Inicialização - garante sessão ativa antes de permitir envio
let initPromise = (async () => {
  await loadSessions();
  checkEngine();
  if (!currentSessionId) {
    const r = await fetch('/Chat/Sessions');
    const list = await r.json();
    if (list.length > 0) {
      await selectSession(list[0].id, list[0].agentId);
    } else {
      await createSession();
    }
  }
})();

// Desabilita send até inicialização completa
const sendBtn = document.getElementById('send');
sendBtn.disabled = true;
initPromise.then(() => { sendBtn.disabled = false; });

document.getElementById('newSession').onclick = createSession;
document.getElementById('clearSessions').onclick = deleteAllSessions;
</script>
}