@{ Layout = "_Layout"; ViewData["Title"] = "Chat"; }
@{
    var agents = (IEnumerable<Rochas.OpenCodeBridge.Web.Models.Agent>)ViewBag.Agents;
}
<section>
  <div class="container py-5">

    <div class="row">

      <div class="col-md-6 col-lg-5 col-xl-4 mb-4 mb-md-0">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Sessões</h5>
          <div>
            <button type="button" class="btn btn-sm btn-info me-2" id="newSession" data-mdb-button-init data-mdb-ripple-init>Nova</button>
            <button type="button" class="btn btn-sm btn-outline-danger" id="clearSessions" data-mdb-button-init data-mdb-ripple-init>Limpar</button>
          </div>
        </div>

        <div class="card">
          <div class="card-body">

            <ul class="list-unstyled mb-0" id="sessionList"></ul>

          </div>
        </div>

      </div>

      <div class="col-md-6 col-lg-7 col-xl-8">

        <div class="mb-4">
          <select id="agentId" class="form-select form-select-sm">
            @foreach (var a in agents)
            {
              <option value="@a.Id">@a.Name — @a.Model</option>
            }
          </select>
          <div class="small text-muted mt-2"><span id="engineDot" class="dot"></span> <span id="engineTxt"></span></div>
        </div>

        <ul class="list-unstyled" id="conv"></ul>

        <ul class="list-unstyled">
          <li class="mb-3">
            <label class="form-label fw-bold" for="prompt">Pergunta ou Instrução</label>
            <div data-mdb-input-init class="form-outline mb-3">
              <textarea class="form-control bg-body-tertiary rounded-3" id="prompt" rows="4" style="border: 1px solid #2a323d !important;"></textarea>
            </div>
          </li>
          <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-info btn-rounded float-end" id="send">Send</button>
        </ul>

      </div>

    </div>

  </div>
</section>
@section Scripts {
<script>
const conv = document.getElementById('conv');
const sessionList = document.getElementById('sessionList');
const agentSel = document.getElementById('agentId');
let sessions = JSON.parse(localStorage.getItem('bridge.sessions') || '[]');
let currentId = null;
const avatarUser = '<span class="rounded-circle d-flex align-self-start ms-3 shadow-1-strong bg-secondary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-user fa-2x text-white"></i></span>';
const avatarAgent = '<span class="rounded-circle d-flex align-self-start me-3 shadow-1-strong bg-primary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-robot fa-2x text-white"></i></span>';

function save() { localStorage.setItem('bridge.sessions', JSON.stringify(sessions)); }
function current() { return sessions.find(s => s.id === currentId); }
function esc(s) { return (s || '').replace(/</g, '&lt;'); }

function newSession() {
  const s = { id: Date.now().toString(), agentId: +agentSel.value, title: 'Nova sessão', messages: [] };
  sessions.unshift(s); currentId = s.id; save(); renderAll();
}

function renderSessions() {
  sessionList.innerHTML = '';
  sessions.forEach((s, i) => {
    const last = s.messages.length ? s.messages[s.messages.length - 1].content : '';
    const li = document.createElement('li');
    li.className = 'p-2 border-bottom' + (s.id === currentId ? ' bg-body-tertiary' : '');
    li.innerHTML = `<a href="#!" class="d-flex justify-content-between text-decoration-none">
      <div class="d-flex flex-row">
        <span class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-info justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-comments fa-2x text-white"></i></span>
        <div class="pt-1">
          <p class="fw-bold mb-0 text-truncate" style="max-width:200px">${esc(s.title)}</p>
          <p class="small text-muted mb-0 text-truncate" style="max-width:200px">${esc(last)}</p>
        </div>
      </div>
      <div class="pt-1"><span class="badge bg-info float-end">${s.messages.length}</span></div>
    </a>`;
    li.querySelector('a').onclick = (e) => { e.preventDefault(); currentId = s.id; agentSel.value = s.agentId; renderAll(); };
    sessionList.appendChild(li);
  });
}

function msgItem(role, think, body) {
  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  if (role === 'user') {
    li.innerHTML = `
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Você</p>
        </div>
        <div class="card-body"><p class="mb-0 text-wrap">${body}</p></div>
      </div>
      ${avatarUser}`;
  } else {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">${think ? `<p class="small text-muted mb-2">${think}</p><hr />` : ''}<p class="mb-0 ans text-wrap">${body}</p></div>
      </div>`;
  }
  return li;
}

function renderConv() {
  conv.innerHTML = '';
  const s = current(); if (!s) return;
  s.messages.forEach(m => conv.appendChild(msgItem(m.role, esc(m.thinking), esc(m.content))));
  window.scrollTo(0, document.body.scrollHeight);
}

function renderAll() { renderSessions(); renderConv(); }

agentSel.onchange = () => { const s = current(); if (s) { s.agentId = +agentSel.value; save(); } checkEngine(); };
async function checkEngine() {
  const dot = document.getElementById('engineDot'), txt = document.getElementById('engineTxt');
  try {
    const r = await fetch(`/Chat/Ping?agentId=${agentSel.value}`);
    const j = await r.json();
    dot.className = 'dot' + (j.ok ? '' : ' err');
    txt.textContent = j.ok ? 'Concluído!' : 'Desconectado';
  } catch { dot.className = 'dot err'; txt.textContent = 'Desconectado'; }
}
checkEngine();
document.getElementById('newSession').onclick = newSession;
document.getElementById('clearSessions').onclick = () => {
  if (!confirm('Limpar todas as sessões?')) return;
  sessions = []; currentId = null; save(); newSession();
};

document.getElementById('send').onclick = async () => {
  const ta = document.getElementById('prompt');
  if (!ta.value.trim()) return;
  if (!current()) newSession();
  const s = current();
  const text = ta.value; ta.value = '';
  if (s.messages.length === 0) s.title = text.slice(0, 40);
  s.messages.push({ role: 'user', content: text });
  conv.appendChild(msgItem('user', '', esc(text)));
  renderSessions();

  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  li.innerHTML = `
    ${avatarAgent}
    <div class="card w-100">
      <div class="card-header d-flex justify-content-between p-3">
        <p class="fw-bold mb-0">Agente</p>
      </div>
      <div class="card-body">
        <div class="d-flex align-items-start">
          <span class="dot blink mt-1"></span>
          <p class="small text-muted mb-0 typing ms-2"><span class="spinner-border spinner-border-sm"></span></p>
        </div>
        <hr /><p class="mb-0 ans text-wrap"></p>
      </div>
    </div>`;
  conv.appendChild(li);
  const thWrap = li.querySelector('.d-flex');
  const dot = li.querySelector('.dot');
  const thP = li.querySelector('p.small');
  const anP = li.querySelector('.ans');
  const engineDot = document.getElementById('engineDot');
  const engineTxt = document.getElementById('engineTxt');
  engineDot.className = 'dot blink'; engineTxt.textContent = 'Pensando...';
  let full = '', think = '';
  try {
    const res = await fetch('/Chat/Stream', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ agentId: s.agentId, messages: s.messages.slice(-20) }) });
    const reader = res.body.getReader(), dec = new TextDecoder();
    let buf = '';
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      const parts = buf.split('\n\n'); buf = parts.pop();
      for (const p of parts) {
        const line = p.split('\n').find(l => l.startsWith('data:'));
        if (!line || line.includes('[DONE]')) continue;
        try {
          const d = JSON.parse(line.slice(5)).choices[0].delta;
          if (d.reasoning_content) { think += d.reasoning_content; thP.textContent = think; }
          else if (d.content) { if (!full) { thP.classList.remove('typing'); anP.classList.add('typing'); } full += d.content; anP.textContent = full; }
        } catch (e) { /* chunk parcial: ignora */ }
      }
      window.scrollTo(0, document.body.scrollHeight);
    }
  } catch (e) {
    anP.textContent = 'erro: ' + e.message;
    dot.className = 'dot err';
    engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado';
  }
  if (dot.className === 'dot blink') dot.className = 'dot';
  if (engineDot.className === 'dot blink') { engineDot.className = 'dot'; engineTxt.textContent = 'Concluído!'; }
  thP.classList.remove('typing');
  anP.classList.remove('typing');
  if (!think) thP.textContent = '';
  s.messages.push({ role: 'assistant', content: full, thinking: think });
  save(); renderSessions();
  window.scrollTo(0, document.body.scrollHeight);
};

renderAll();
if (!current() && sessions.length === 0) newSession();
else if (!current() && sessions.length > 0) { currentId = sessions[0].id; renderAll(); }
</script>
}
