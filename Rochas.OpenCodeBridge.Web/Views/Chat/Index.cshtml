@{ Layout = "_Layout"; ViewData["Title"] = "Chat"; }
@{
    var agents = (IEnumerable<Rochas.OpenCodeBridge.Web.Models.Agent>)ViewBag.Agents;
}
<section>
  <div class="container py-5">

    <div class="row">

      <div class="col-md-6 col-lg-4 col-xl-3 mb-4 mb-md-0">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Sessões</h5>
          <div>
            <button type="button" class="btn btn-sm btn-info me-2" id="newSession" data-mdb-button-init data-mdb-ripple-init>Nova</button>
            <button type="button" class="btn btn-sm btn-danger text-black" id="clearSessions" data-mdb-button-init data-mdb-ripple-init>Limpar</button>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <ul class="list-unstyled mb-0" id="sessionList"></ul>
          </div>
        </div>

      </div>

      <div class="col-md-6 col-lg-8 col-xl-6">

        <div class="mb-4">
          <select id="agentId" class="form-select form-select-sm" title="Orquestrador">
            @foreach (var a in agents)
            {
              <option value="@a.Id" data-mode="@(string.IsNullOrEmpty(a.Mode) ? "build" : a.Mode)">@a.Name — @a.Model</option>
            }
          </select>
          <select id="executorId" class="form-select form-select-sm mt-2" title="Executor (opcional)">
            <option value="">Executor: nenhum (chat simples)</option>
            @foreach (var a in agents)
            {
              <option value="@a.Id" data-mode="@(string.IsNullOrEmpty(a.Mode) ? "build" : a.Mode)" selected="@(a.Role == "executor")">@a.Name — @a.Model</option>
            }
          </select>
          <div class="small text-muted mt-2"><span id="engineDot" class="dot"></span> <span id="engineTxt">Aguardando...</span></div>
        </div>

        <ul class="list-unstyled" id="conv" aria-live="polite" aria-atomic="false"></ul>

        <ul class="list-unstyled">
          <li class="mb-3">
            <label class="form-label fw-bold text-white" for="prompt">Pergunta ou Instrução</label>
            <div data-mdb-input-init class="form-outline mb-3">
              <textarea class="form-control bg-body-tertiary rounded-3" id="prompt" rows="4" style="border: 1px solid #2a323d !important;"></textarea>
            </div>
          </li>
          <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-info float-end" id="send">ENVIAR</button>
        </ul>

      </div>

      <div class="col-md-12 col-lg-12 col-xl-3">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Tarefas do Executor</h5>
        </div>

        <div class="card">
          <div class="card-body">
            <ul class="list-unstyled mb-0" id="taskList">
              <li class="small text-muted">Sem decomposição nesta sessão.</li>
            </ul>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
<!-- MDB Toast container for errors -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;" id="toastContainer"></div>
@section Scripts {
<script>
const conv = document.getElementById('conv');
const sessionList = document.getElementById('sessionList');
const agentSel = document.getElementById('agentId');
const execSel = document.getElementById('executorId');
const engineDot = document.getElementById('engineDot');
const engineTxt = document.getElementById('engineTxt');
const toastContainer = document.getElementById('toastContainer');
let currentSessionId = null;
let currentAgentId = null;
let currentExecutorId = null;
let uiConfig = { directApprove: false };
fetch('/Chat/Config').then(r => r.json()).then(j => { uiConfig.directApprove = !!j.directApprove; }).catch(() => {});
const execIdOrNull = () => execSel.value ? +execSel.value : null;

// Stream ativo por sessão: trocar de sessão aborta o anterior (bolhas independentes).
function abortActiveStream() {
  try { window._streamAbort?.abort(); } catch {}
  if (window._streamSession) {
    fetch('/Chat/Stop', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: window._streamSession }) }).catch(() => {});
  }
  window._streamAbort = null; window._streamSession = null;
  document.getElementById('cancelBtn')?.remove();
  document.getElementById('processing-indicator')?.remove();
}

const avatarUser = '<span class="rounded-circle d-flex align-self-start ms-3 shadow-1-strong bg-secondary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-user fa-2x text-white"></i></span>';
const avatarAgent = '<span class="rounded-circle d-flex align-self-start me-3 shadow-1-strong bg-primary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-robot fa-2x text-white"></i></span>';

function esc(s) { return (s || '').replace(/<\/?(details|summary)(\s[^>]*)?>/gi, '').replace(/\\"/g, '"').replace(/\\n/g, '\n').replace(/\\t/g, '\t').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

function showToast(message, type = 'danger') {
  const id = 'toast-' + Date.now();
  const bg = type === 'danger' ? 'bg-danger' : (type === 'success' ? 'bg-success' : 'bg-info');
  const icon = type === 'danger' ? 'fa-circle-exclamation' : (type === 'success' ? 'fa-circle-check' : 'fa-circle-info');
  const toastHtml = `
    <div id="${id}" class="toast ${bg} text-white" role="alert" aria-live="assertive" aria-atomic="true" data-mdb-delay="5000">
      <div class="toast-header ${bg} text-white border-0">
        <i class="fas ${icon} me-2"></i>
        <strong class="me-auto">Bridge Web</strong>
        <button type="button" class="btn-close btn-close-white" data-mdb-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body">${esc(message)}</div>
    </div>`;
  toastContainer.insertAdjacentHTML('beforeend', toastHtml);
  const toastEl = document.getElementById(id);
  if (toastEl) {
    const toast = new mdb.Toast(toastEl);
    toast.show();
    toastEl.addEventListener('hidden.mdb.toast', () => toastEl.remove());
  }
}

function isScrolledToBottom() {
  return conv.scrollTop + conv.clientHeight >= conv.scrollHeight - 50;
}

// Linha de status de tool (mesmo padrão do Raciocínio): details fechado com retorno.
function toolStatus(name, running, ok, result, ms, args) {
  if (running) {
    if (name === 'subagent') {
      // Sub Agente: sem label durante a execução (só o "Processando...");
      // a bolha abre no done, quando o texto chega.
      return;
    } else {
      const li = document.createElement('li');
      li.className = 'd-flex justify-content-start mt-1 mb-1 tool-status';
      li.dataset.tool = name;
      const a = (args || '').replace(/\s+/g, ' ').trim();
      li.innerHTML = `<span class="small text-muted"><span class="dot blink me-1"></span>Executando ${esc(name)}${a ? ' ' + esc(a) : ''}...</span>`;
      // Sequência de tools sempre acima do card de texto do agente (abaixo do Processando).
      const bub = window._agentBubble;
      if (bub && bub.isConnected) conv.insertBefore(li, bub);
      else conv.appendChild(li);
    }
  } else {
    // Sub Agente abre a bolha direto (sem linha prévia): só chega o done com o texto.
    if (name === 'subagent' && ok !== false && result) {
      const items = conv.querySelectorAll('.tool-status');
      items.forEach(el => { if (el.dataset.tool === name) el.remove(); });
      // Sub Agente: card próprio ABAIXO do card do agente, com digitando igual.
      const card = document.createElement('li');
      card.className = 'd-flex justify-content-between mb-4 subagent-card';
      card.innerHTML = `
          ${avatarAgent}
          <div class="card w-100">
            <div class="card-header d-flex justify-content-between p-3">
              <p class="fw-bold mb-0">Sub Agente</p>
            </div>
            <div class="card-body">
              <pre class="mb-0 subans rawbox"></pre>
            </div>
          </div>`;
        // Pilha LIFO acima da bolha: o mais recente entra no topo (antes do anterior).
        const prev = window._lastSubCard;
        if (prev && prev.isConnected) prev.before(card);
        else {
          const bub = window._agentBubble;
          if (bub && bub.isConnected) conv.insertBefore(card, bub);
          else conv.appendChild(card);
        }
        window._lastSubCard = card;
        (window._liveSubs = window._liveSubs || []).push(card);
        const p = card.querySelector('.subans');
        let body = result, think = '';
        const hm = body.match(/<SUBTHINK>([\s\S]*)<\/SUBTHINK>/);
        if (hm) { think = hm[1].trim(); body = body.replace(hm[0], '').trim(); }
        let det = null, pp = null;
        if (think) {
          det = document.createElement('details');
          det.setAttribute('open', '');
          det.className = 'mb-2';
          det.innerHTML = `<summary class="small text-muted">Raciocínio</summary>`;
          pp = document.createElement('p');
          pp.className = 'small text-muted';
          det.appendChild(pp);
          p.parentNode.insertBefore(det, p);
        }
        // Sub: mesma dinâmica — thinking digita aberto, fecha, corpo digita abaixo.
        const typeBody = () => {
          const words = body.split(/(\s+)/);
          let shown = 0;
          p.classList.add('typing');
          const timer = setInterval(() => {
            shown = Math.min(shown + 4, words.length);
            p.textContent = words.slice(0, shown).join('');
            if (isScrolledToBottom()) scrollToBottom();
            if (shown >= words.length) { clearInterval(timer); p.classList.remove('typing'); }
          }, 90);
        };
        if (think && det && pp) {
          pp.classList.add('typing');
          const chars = think.split('');
          let ci = 0;
          const tTimer = setInterval(() => {
            ci = Math.min(ci + 60, chars.length);
            pp.textContent = chars.slice(0, ci).join('');
            pp.scrollTop = pp.scrollHeight;
            if (isScrolledToBottom()) scrollToBottom();
            if (ci >= chars.length) {
              clearInterval(tTimer);
              pp.classList.remove('typing');
              det.removeAttribute('open');
              typeBody();
            }
          }, 60);
        } else typeBody();
    } else {
      const items2 = conv.querySelectorAll('.tool-status');
      let li = null;
      items2.forEach(el => { if (!li && el.dataset.tool === name) li = el; });
      if (li) {
        const state = ok === false ? 'falhou' : 'executado com sucesso';
        const body = result ? `<p class="small text-muted">${esc(result)}</p>` : '';
        li.innerHTML = `<details class="mb-2"><summary class="small text-muted">${esc(name)} ${state}.</summary>${body}</details>`;
        li.classList.remove('tool-status');
      }
    }
  }
  if (isScrolledToBottom()) scrollToBottom();
}

function scrollToBottom() {
  conv.scrollTo({ top: conv.scrollHeight, behavior: 'smooth' });
}

async function loadSessions() {
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  sessionList.innerHTML = '';
  list.forEach(s => {
    const li = document.createElement('li');
    li.className = 'p-2 border-bottom' + (s.id === currentSessionId ? ' bg-body-tertiary' : '');
    const updated = new Date(s.createdAt).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    li.innerHTML = `<a href="#!" class="d-flex justify-content-between text-decoration-none">
      <div class="d-flex flex-row">
        <span class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-info justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-comments fa-2x text-white"></i></span>
        <div class="pt-1">
          <p class="fw-bold mb-0 text-truncate" style="max-width:200px">${esc(s.title)}</p>
          <p class="small text-muted mb-0">${updated}</p>
        </div>
      </div>
      <span class="align-self-center text-danger del-session" title="Excluir" style="cursor:pointer"><i class="fas fa-trash-alt"></i></span>
    </a>`;
    li.querySelector('a').onclick = (e) => { e.preventDefault(); selectSession(s.id, s.agentId, s.executorAgentId); };
    li.querySelector('.del-session').onclick = async (e) => {
      e.preventDefault(); e.stopPropagation();
      await fetch(`/Chat/Sessions/${s.id}`, { method: 'DELETE' });
      if (currentSessionId === s.id) { currentSessionId = null; conv.innerHTML = ''; }
      await loadSessions();
    };
    sessionList.appendChild(li);
  });
}

async function selectSession(id, agentId, executorAgentId) {
  if (window._streamSession && window._streamSession !== id) abortActiveStream();
  currentSessionId = id;
  currentAgentId = agentId;
  agentSel.value = agentId;
  currentExecutorId = executorAgentId ?? null;
  filterExecutors();
  execSel.value = currentExecutorId ?? '';
  await loadMessages(id);
  await loadSessions();
  checkEngine();
}

async function loadMessages(sessionId) {
  const r = await fetch(`/Chat/Sessions/${sessionId}/Messages`);
  const msgs = await r.json();
  const wasAtBottom = isScrolledToBottom();
  conv.innerHTML = '';
  // Toda msg renderiza: falha isolada vira bolha bruta, nunca aborta a conversa.
  (msgs || []).forEach(m => {
    try {
      conv.appendChild(msgItem(m?.role ?? 'assistant', m?.thinking ?? '', m?.content ?? ''));
    } catch (err) {
      const li = document.createElement('li');
      li.className = 'd-flex justify-content-between mb-4';
      li.innerHTML = `${avatarAgent}<div class="card w-100"><div class="card-header d-flex justify-content-between p-3"><p class="fw-bold mb-0">Agente</p></div><div class="card-body"><pre class="mb-0 ans rawbox">${esc(String(m?.content ?? ''))}</pre></div></div>`;
      conv.appendChild(li);
    }
  });
  if (wasAtBottom) scrollToBottom();
  await loadTasks(sessionId);
}

// Painel lateral: decomposição + status das mini-tarefas dos executores
async function loadTasks(sessionId) {
  const list = document.getElementById('taskList');
  try {
    const r = await fetch(`/Chat/Sessions/${sessionId}/Tasks`);
    if (!r.ok) return;
    const j = await r.json();
    if (!j.tasks || !j.tasks.length) {
      list.innerHTML = '<li class="small text-muted">Sem decomposição nesta sessão.</li>';
      return;
    }
    list.innerHTML = '';
    let totalEta = 0;
    j.tasks.forEach(t => {
      const li = document.createElement('li');
      li.className = 'mb-2';
      const badge = t.status === 'done'
        ? '<span class="badge bg-success">concluída</span>'
        : t.status === 'running'
          ? '<span class="badge bg-info"><span class="spinner-border spinner-border-sm me-1"></span>executando</span>'
          : '<span class="badge bg-secondary">pendente</span>';
      const eta = t.etaMin > 0 ? ` <span class="text-muted">~${t.etaMin} min</span>` : '';
      if (t.etaMin > 0) totalEta += t.etaMin;
      const summary = t.promptSummary ? `<div class="small text-muted mt-1">${esc(t.promptSummary)}</div>` : '';
      const tools = (t.toolCalls && t.toolCalls.length)
        ? `<div class="mt-1">${t.toolCalls.map(c => `<span class="badge bg-dark me-1">${esc(c)}</span>`).join('')}</div>`
        : '';
      li.innerHTML = `<div class="small fw-bold">${t.index}. ${esc(t.title)}${eta}</div>${summary}${tools}<div class="mt-1">${badge}</div>`;
      list.appendChild(li);
    });
    if (totalEta > 0) {
      const li = document.createElement('li');
      li.className = 'mt-1 mb-2';
      li.innerHTML = `<span class="small text-muted">Total estimado: ~${Math.round(totalEta * 10) / 10} min</span>`;
      list.appendChild(li);
    }
    if (j.synthesized) {
      const li = document.createElement('li');
      li.className = 'mt-2';
      li.innerHTML = '<span class="badge bg-primary">síntese pronta</span>';
      list.appendChild(li);
    }
  } catch { /* painel opcional: ignora */ }
}

// Atualiza o painel a cada 5s enquanto há sessão ativa
setInterval(() => { if (currentSessionId) loadTasks(currentSessionId); }, 5000);

async function createSession() {
  abortActiveStream();
  const r = await fetch('/Chat/Sessions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ agentId: +agentSel.value, executorAgentId: execIdOrNull(), title: 'Nova sessão' })
  });
  const s = await r.json();
  currentSessionId = s.id;
  currentAgentId = s.agentId;
  agentSel.value = s.agentId;
  currentExecutorId = s.executorAgentId ?? null;
  filterExecutors();
  execSel.value = currentExecutorId ?? '';
  await loadSessions();
  conv.innerHTML = '';
}

async function deleteAllSessions() {
  if (!confirm('Excluir todas as sessões?')) return;
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  for (const s of list) {
    await fetch(`/Chat/Sessions/${s.id}`, { method: 'DELETE' });
  }
  currentSessionId = null;
  currentAgentId = null;
  currentExecutorId = null;
  await loadSessions();
  conv.innerHTML = '';
}

function msgItem(role, think, body) {
  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  if (role === 'user') {
    li.innerHTML = `
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Você</p>
        </div>
        <div class="card-body"><p class="mb-0 text-wrap">${esc(body)}</p></div>
      </div>
      ${avatarUser}`;
  } else if (role === 'subagent') {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Sub Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${(body || '').trim() ? `<pre class="mb-0 subans rawbox">${esc(body)}</pre>` : ''}
        </div>
      </div>`;
  } else {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${(body || '').trim() ? `<pre class="mb-0 ans rawbox">${esc(body)}</pre>` : ''}
        </div>
      </div>`;
  }
  return li;
}

agentSel.onchange = () => { currentAgentId = +agentSel.value; filterExecutors(); checkEngine(); };

// Executor lista só o mesmo modo do orquestrador (plan com plan, build com build)
function orchMode() {
  const opt = agentSel.selectedOptions[0];
  return opt ? (opt.dataset.mode || 'build') : 'build';
}
function filterExecutors() {
  const mode = orchMode();
  let visible = 0;
  [...execSel.options].forEach(o => {
    if (!o.value) return;
    const show = (o.dataset.mode || 'build') === mode;
    o.hidden = !show;
    if (show) visible++;
  });
  if (execSel.value && execSel.selectedOptions[0]?.hidden) execSel.value = '';
  execSel.disabled = visible === 0;
}

execSel.onchange = async () => {
  currentExecutorId = execIdOrNull();
  if (!currentSessionId) return;
  const r = await fetch(`/Chat/Sessions/${currentSessionId}/Executor`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ executorAgentId: currentExecutorId })
  });
  if (!r.ok) showToast('Executor inválido para esta sessão.', 'warning');
  await loadSessions();
};

async function checkEngine() {
  try {
    const r = await fetch(`/Chat/Ping?agentId=${agentSel.value}`);
    const j = await r.json();
    engineDot.className = 'dot' + (j.ok ? '' : ' err');
    engineTxt.textContent = j.ok ? 'Concluído!' : 'Desconectado';
  } catch { engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado'; }
}

document.getElementById('newSession').onclick = createSession;

const promptEl = document.getElementById('prompt');
promptEl.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    document.getElementById('send').click();
  }
});

promptEl.addEventListener('blur', () => {
  // Opcional: re-focar após envio (feito no send.onclick)
});

document.getElementById('send').onclick = async () => {
  const ta = document.getElementById('prompt');
  if (!ta.value.trim()) return;
  if (!currentSessionId) {
    // Se não há sessão, tenta criar uma
    await createSession();
    if (!currentSessionId) {
      showToast('Nenhuma sessão disponível. Recarregue a página.', 'warning');
      return;
    }
  }
  const text = ta.value; ta.value = '';

  ta.disabled = true;
  sendBtn.disabled = true;
  sendBtn.innerHTML = 'Enviado';

  // Botão Parar (cancela o processamento); remove resto de envio anterior.
  document.getElementById('cancelBtn')?.remove();
  const cancelBtn = document.createElement('button');
  cancelBtn.type = 'button';
  cancelBtn.className = 'btn btn-sm btn-danger text-black ms-2';
  cancelBtn.id = 'cancelBtn';
  cancelBtn.innerHTML = 'CANCELAR';
  cancelBtn.style.display = 'none';
  sendBtn.parentNode.insertBefore(cancelBtn, sendBtn.nextSibling);
  
  // AbortController for cancellation
  const abortController = new AbortController();
  const sendSessionId = currentSessionId;
  window._streamSession = sendSessionId; window._streamAbort = abortController;
  let stoppedByUser = false;
  cancelBtn.style.display = 'inline-block';
  cancelBtn.onclick = () => {
    stoppedByUser = true;
    // Para o servidor via API + corta o fetch local.
    fetch('/Chat/Stop', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: sendSessionId }) }).catch(() => {});
    try { abortController.abort(); } catch {}
    window._streamAbort = null; window._streamSession = null;
    cancelBtn.style.display = 'none';
    document.getElementById('processing-indicator')?.remove();
    stopTypewriter();
    if (anP) anP.classList.remove('typing');
    engineTxt.textContent = 'Interrompido';
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    ta.focus();
  };
  
  ta.focus();

  // Adiciona mensagem do usuário na UI imediatamente
  conv.appendChild(msgItem('user', '', esc(text)));

  // Indicador "Processando" como linha da conversa (com margem), ativo até finalizar
  const indicator = document.createElement('li');
  indicator.id = 'processing-indicator';
  indicator.className = 'd-flex justify-content-end mt-2 mb-3';
  indicator.innerHTML = '<span class="small text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Processando...</span>';
  conv.appendChild(indicator);
  if (isScrolledToBottom()) scrollToBottom();

  // Prepara bolha do agente (abre no thinking ou no texto real; nunca vazia parada)
  let agentLi = null;
  window._agentBubble = null;
  window._lastSubCard = null;
  window._liveSubs = [];
  let anP = null;
  let think = '';
  let thinkDet = null;
  let thinkP = null;
  let thinkLive = false;
  let full = '';
  let agentBubbleCreated = false;

  // Abre a bolha (uma vez) e ancora os sub cards do envio abaixo dela.
  function ensureAgentBubble() {
    if (agentBubbleCreated) return;
    agentLi = document.createElement('li');
    agentLi.className = 'd-flex justify-content-between mb-4';
    agentLi.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          <pre class="mb-0 ans rawbox"></pre>
        </div>
      </div>`;
    conv.appendChild(agentLi);
    anP = agentLi.querySelector('.ans');
    agentBubbleCreated = true;
    window._agentBubble = agentLi;
    // Pilha do envio: subs acima da bolha, mais recente no topo.
    let anchor = agentLi;
    (window._liveSubs || []).forEach(c => { if (c.isConnected) { anchor.before(c); anchor = c; } });
  }

  // Efeito "digitando" palavra por palavra (JS puro)
  let shownWords = 0;
  let typeTimer = null;
  function renderWords() {
    if (!anP) return;
    const parts = full.split(/(\s+)/);
    shownWords = Math.min(shownWords, parts.length);
    anP.textContent = parts.slice(0, shownWords).join('');
  }
  function drainWords() {
    if (!anP) return;
    const total = full.split(/(\s+)/).length;
    const backlog = total - shownWords;
    if (backlog <= 0) return;
    // Ritmo legível (~20 palavras/s); acelera só sob grande acúmulo
    shownWords += backlog > 100 ? 10 : backlog > 40 ? 5 : 2;
    renderWords();
  }
  function startTypewriter() {
    if (typeTimer) return;
    if (anP) anP.classList.add('typing');
    typeTimer = setInterval(drainWords, 90);
  }
  function stopTypewriter() {
    if (typeTimer) { clearInterval(typeTimer); typeTimer = null; }
    if (anP) { shownWords = full.split(/(\s+)/).length; renderWords(); anP.classList.remove('typing'); }
  }

  engineDot.className = 'dot blink'; engineTxt.textContent = 'Pensando...';

  try {
    const res = await fetch('/Chat/Stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: currentSessionId, agentId: currentAgentId, messages: [{ role: 'user', content: text }] }), signal: abortController.signal
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    // Parar segue visível durante todo o stream; ENVIAR só volta no fim.
    // (nada de reabilitar aqui: o stream longo precisa do Parar até o done)

    const reader = res.body.getReader(), dec = new TextDecoder();
    let buf = '';
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      if (currentSessionId !== sendSessionId) break;
      buf += dec.decode(value, { stream: true });
      const parts = buf.split('\n\n'); buf = parts.pop();
      for (const p of parts) {
        const line = p.split('\n').find(l => l.startsWith('data:'));
        if (!line || line.includes('[DONE]')) continue;
        try {
          const evt = JSON.parse(line.slice(5));
          if (evt.progress) {
            // Progresso de tool vindo do servidor
            if (evt.progress === 'tool_start') toolStatus(evt.name, true, null, '', 0, evt.args || '');
            else if (evt.progress === 'tool_done') toolStatus(evt.name, false, evt.ok, evt.result || '', evt.ms || 0);
            continue;
          }
          const d = evt.choices[0].delta;
          if (d.reasoning_content) {
            // Thinking acumula no MESMO accordion da bolha (abre, digita, fecha no texto).
            think += d.reasoning_content;
            ensureAgentBubble();
            if (!thinkDet) {
              thinkDet = document.createElement('details');
              thinkDet.className = 'mb-2';
              thinkDet.innerHTML = `<summary class="small text-muted">Raciocínio</summary>`;
              thinkP = document.createElement('p');
              thinkP.className = 'small text-muted typing';
              thinkDet.appendChild(thinkP);
              anP.parentNode.insertBefore(thinkDet, anP);
              thinkLive = true;
            }
            thinkDet.setAttribute('open', '');
            if (thinkP) thinkP.classList.add('typing');
            thinkP.textContent = think;
            thinkP.scrollTop = thinkP.scrollHeight;
            engineTxt.textContent = 'Pensando...';
          }
          else if (d.content) {
            full += d.content;
            // Sem salto inicial em nenhum caminho (bolha aberta pelo thinking ou pelo texto):
            // enquanto só há espaço, apara a frente; texto real nunca é tocado.
            if (!full.trim()) full = '';
            else full = full.replace(/^\s+/, '');
            // Bolha só quando há texto real (deltas iniciais de espaço não abrem quadro vazio).
            if (!agentBubbleCreated && full.trim()) ensureAgentBubble();
            // Thinking encerrou: fecha o accordion (mantém ref p/ acumular) e o texto começa abaixo.
            if (thinkDet) { thinkDet.removeAttribute('open'); if (thinkP) thinkP.classList.remove('typing'); }
            startTypewriter();
          }
        } catch (e) { /* chunk parcial: ignora */ }
      }
      if (isScrolledToBottom()) scrollToBottom();
    }
  } catch (e) {
    if (stoppedByUser || e?.name === 'AbortError') {
      // Parada pelo usuário: sem bolha de erro nem toast.
      engineTxt.textContent = 'Interrompido';
      ta.disabled = false;
      sendBtn.disabled = false;
      sendBtn.innerHTML = 'ENVIAR';
      stopTypewriter();
      document.getElementById('processing-indicator')?.remove();
      document.getElementById('cancelBtn')?.remove();
      return;
    }
    if (!agentBubbleCreated) {
      // Cria bolha de erro se nem começou
      agentLi = document.createElement('li');
      agentLi.className = 'd-flex justify-content-between mb-4';
      agentLi.innerHTML = `${avatarAgent}<div class="card w-100"><div class="card-body"><p class="mb-0 ans text-danger">Erro: ${esc(e.message)}</p></div></div>`;
      conv.appendChild(agentLi);
    } else {
      anP.textContent = 'Erro: ' + e.message;
    }
    engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado';
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    stopTypewriter();
    document.getElementById('processing-indicator')?.remove();
    document.getElementById('cancelBtn')?.remove();
    showToast('Erro ao conectar na engine. Verifique se a bridge está online.', 'danger');
  }
  window._streamAbort = null; window._streamSession = null;
  // Trocou de sessão no meio do stream: não finaliza bolha na conversa errada.
  const stillHere = (currentSessionId === sendSessionId);
  if (agentBubbleCreated && stillHere) {
    // Flush final do efeito + thinking fechado + remove "Processando"
    stopTypewriter();
    if (thinkDet) { thinkDet.removeAttribute('open'); if (thinkP) thinkP.classList.remove('typing'); }
    else if (thinkLive && anP) {
      // Thinking já exibido ao vivo (accordion aberto e fechado): garante fechado.
      anP.parentNode.querySelectorAll('details').forEach(d => d.removeAttribute('open'));
    }
    if (!thinkLive && think.trim() && anP) {
      const det = document.createElement('details');
      det.className = 'mb-2';
      const sum = document.createElement('summary');
      sum.className = 'small text-muted';
      sum.textContent = 'Raciocínio';
      const p = document.createElement('p');
      p.className = 'small text-muted';
      p.textContent = think;
      det.appendChild(sum);
      det.appendChild(p);
      anP.parentNode.insertBefore(det, anP);
    }
    document.getElementById('processing-indicator')?.remove();
    engineDot.className = 'dot'; engineTxt.textContent = 'Concluído!';
  } else if (stillHere) {
    document.getElementById('processing-indicator')?.remove();
  }
  ta.disabled = false;
  sendBtn.disabled = false;
  sendBtn.innerHTML = 'ENVIAR';
  document.getElementById('cancelBtn')?.remove();
  ta.focus();
  if (stillHere && isScrolledToBottom()) scrollToBottom();
};

// Inicialização - garante sessão ativa antes de permitir envio
let initPromise = (async () => {
  await loadSessions();
  checkEngine();
  if (!currentSessionId) {
    const r = await fetch('/Chat/Sessions');
    const list = await r.json();
    if (list.length > 0) {
      await selectSession(list[0].id, list[0].agentId, list[0].executorAgentId);
    } else {
      await createSession();
    }
  }
})();

// Desabilita send até inicialização completa
const sendBtn = document.getElementById('send');
sendBtn.disabled = true;
initPromise.then(() => { sendBtn.disabled = false; });

document.getElementById('newSession').onclick = createSession;
document.getElementById('clearSessions').onclick = deleteAllSessions;
</script>
}