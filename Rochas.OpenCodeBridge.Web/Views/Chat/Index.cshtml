async function createSession() {
  abortActiveStream();
  const r = await fetch('/Chat/Sessions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ agentId: +agentSel.value, executorAgentId: execIdOrNull(), title: 'Nova sessão' })
  });
  const s = await r.json();
  currentSessionId = s.id;
  currentAgentId = s.agentId;
  agentSel.value = s.agentId;
  currentExecutorId = s.executorAgentId ?? null;
  filterExecutors();
  execSel.value = currentExecutorId ?? '';
  await loadSessions();
  conv.innerHTML = '';
  updateCtxDonut();
}

async function deleteAllSessions() {
  if (!confirm('Excluir todas as sessões?')) return;
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  for (const s of list) {
    await fetch(`/Chat/Sessions/${s.id}`, { method: 'DELETE' });
  }
  currentSessionId = null;
  currentAgentId = null;
  currentExecutorId = null;
  await loadSessions();
  conv.innerHTML = '';
}

function fmtTs(iso) {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    const p = n => String(n).padStart(2, '0');
    return `${p(d.getDate())}/${p(d.getMonth() + 1)} ${p(d.getHours())}:${p(d.getMinutes())}`;
  } catch { return ''; }
}
function toolsGroupHtml(tools) {
  if (!tools || !tools.length) return '';
  const items = tools.map(c => {
    const state = c?.ok === false ? 'falhou' : 'executado com sucesso';
    // Delegação externa: sem despejo do resultado no sucesso (o card do sub
    // já mostra); falha sem card mostra o motivo (paridade com o ao vivo).
    const outerSub = c?.name === 'subagent' && !c?.sub;
    const out = ((!outerSub || c?.ok === false) && c?.output) ? `<p class="small text-muted">${esc(c.output)}</p>` : '';
    const psnip = outerSub ? subPromptOf(c?.args).slice(0, 160) : '';
    const rawhead = ((c?.args || '').replace(/\s+/g, ' ').trim()).slice(0, 80);
    const a = psnip || rawhead;
    const ah = a ? ` <span class="text-muted">${esc(a)}${(!psnip && (c?.args || '').length > 80) || (psnip && subPromptOf(c?.args).length > 160) ? '…' : ''}</span>` : '';
    const tlabel = outerSub ? 'Subagente' : esc(c?.name ?? 'tool');
    return `<details class="mb-1 tool-item"><summary class="small text-muted">${tlabel} ${state}.${ah}</summary>${out}</details>`;
  }).join('');
  return `<details class="mb-2 tools-group" open><summary class="small text-muted">Ferramentas (${tools.length})</summary><div class="tlist">${items}</div></details>`;
}
function msgItem(role, think, body, ts, tools) {
  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  const foot = ts ? `<div class="msg-ts">${esc(fmtTs(ts))}</div>` : '';
  if (role === 'user') {
    li.innerHTML = `
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Você</p>
        </div>
        <div class="card-body"><p class="mb-0 text-wrap">${esc(body)}</p>${foot}</div>
      </div>
      ${avatarUser}`;
  } else if (role === 'subagent') {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Sub Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio 100%</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${toolsGroupHtml(tools)}
          ${(body || '').trim() ? `<pre class="mb-0 subans rawbox">${esc(body)}</pre>` : ''}
          ${foot}
        </div>
      </div>`;
  } else {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio 100%</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${toolsGroupHtml(tools)}
          ${(body || '').trim() ? `<pre class="mb-0 ans rawbox">${esc(body)}</pre>` : ''}
          ${foot}
        </div>
      </div>`;
  }
  return li;
}

agentSel.onchange = () => { currentAgentId = +agentSel.value; filterExecutors(); checkEngine(); };

// Executor lista todos, sem amarra de modo (plan+build é topologia válida).
function orchMode() {
  const opt = agentSel.selectedOptions[0];
  return opt ? (opt.dataset.mode || 'build') : 'build';
}
function filterExecutors() {
  [...execSel.options].forEach(o => { if (o.value) o.hidden = false; });
  execSel.disabled = ![...execSel.options].some(o => o.value);
}

execSel.onchange = async () => {
  currentExecutorId = execIdOrNull();
  if (!currentSessionId) return;
  const r = await fetch(`/Chat/Sessions/${currentSessionId}/Executor`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ executorAgentId: currentExecutorId })
  });
  if (!r.ok) showToast('Executor inválido para esta sessão.', 'warning');
