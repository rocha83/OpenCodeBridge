@{ Layout = "_Layout"; ViewData["Title"] = "Login"; }
<div class="row justify-content-center mt-5">
  <div class="col-md-4">
    <div class="card p-4">
      <h5>bridge.web</h5>
      @if (ViewBag.Error is not null) { <div class="alert alert-danger">@ViewBag.Error</div> }
      <form method="post">
        <input name="email" class="form-control mb-2" placeholder="Email" value="admin@mova.com" />
        <input name="password" type="password" class="form-control mb-2" placeholder="Senha" />
        <button class="btn btn-primary w-100">Entrar</button>
      </form>
    </div>
  </div>
</div>

