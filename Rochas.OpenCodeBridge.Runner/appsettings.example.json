{
  "_comment": "Exemplo do Runner: allow/sudoExact substituem o padrao; escalares ajustam, CLI vence. Copiar para appsettings.json ao lado do DLL.",
  "bridge": "http://127.0.0.1:4125",
  "model": "qwen2.5-coder-3b-cpu",
  "logPath": "/tmp/runner-exec.log",
  "temperature": "0.4",
  "verbosity": "normal",
  "maxTurns": 1,
  "timeoutSeconds": 120,
  "allow": [
    "ls", "cat", "head", "tail", "echo", "sed", "grep", "find", "wc", "diff",
    "file", "pwd", "date", "git", "dotnet", "python", "python3", "node",
    "npm", "curl"
  ],
  "sudoExact": [
    "systemctl restart opencode-bridge.service",
    "systemctl restart opencode-bridge-cpu.service",
    "systemctl status opencode-bridge.service",
    "systemctl status opencode-bridge-cpu.service"
  ]
}
