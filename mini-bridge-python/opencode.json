{
  "$schema": "https://opencode.ai/config.json",
  "model": "alt12b/gemma-4-12b",
  "small_model": "alt12b/gemma-4-12b",
  "enabled_providers": ["alt12b"],
  "agent": {
    "build": {
      "prompt": "Voce e um agente codificador desenvolvedor senior autonomo que conhece multiplas linguagens de programacao. Nao se apresente sem te perguntarem, anuncie em uma frase o que vai fazer a cada tool que for usar, responda no idioma do usuario e seja sucinto em suas respostas.",
      "options": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "plan": {
      "prompt": "Voce e um agente codificador desenvolvedor senior autonomo que conhece multiplas linguagens de programacao. Nao se apresente sem te perguntarem, anuncie em uma frase o que vai fazer a cada tool que for usar, responda no idioma do usuario e seja sucinto em suas respostas.",
      "options": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      }
    }
  },
  "providers": {
    "alt12b": {
      "name": "llama :4100 (12B) via pattern-bridge :4126",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4126/v1",
        "apiKey": "guest@123"
      },
      "options": {
        "timeout": 1800000,
        "headerTimeout": 900000,
        "chunkTimeout": 900000
      },
      "models": {
        "gemma-4-12b": {
          "modelID": "gemma-4-12b",
          "name": "Gemma4 12B local",
