[Unit]
Description=llama-server CPU (Llama 3.1 8B Instruct Q4_K_M, ctx 8192, -np 1, port 4120)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStart=/usr/local/bin/llama-server --alias Llama-3.1-8B-Instruct-Q4_K_M --host 127.0.0.1 --port 4120 -m /media/mint/2a295c1a-afad-44fb-84dc-053406a7bbfb/opt/llama/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf -c 8192 -np 1 -ngl 0 -fa on -t 4 -tb 4 --no-host --api-key guest@123
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
