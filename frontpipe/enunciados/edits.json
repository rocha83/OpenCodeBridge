[
  {
    "id": "titulo-2px",
    "titulo": "titulo 2px de font-size acima do que esta",
    "file": "edit-titulo-2px.md",
    "selector": "#titulo",
    "prop": "font-size",
    "op": "delta",
    "value": 2,
    "tol": 0.5,
    "no_regress": ["#quadro:rect_w", "#quadro:rect_h", "#titulo:font-weight"]
  },
  {
    "id": "quadro-320px",
    "titulo": "quadro com largura exata de 320px",
    "file": "edit-quadro-320px.md",
    "selector": "#quadro",
    "prop": "rect_w",
    "op": "eq",
    "value": 320,
    "tol": 1,
    "no_regress": ["#titulo:font-size", "#quadro:padding-left", "#quadro:rect_h"]
  },
  {
    "id": "quadro-padding-16",
    "titulo": "espacamento interno do quadro em 16px",
    "file": "edit-quadro-padding-16.md",
    "selector": "#quadro",
    "prop": "padding-left",
    "op": "eq",
    "value": 16,
    "tol": 0.5,
    "no_regress": ["#quadro:rect_w", "#titulo:font-size"]
  },
  {
    "id": "razor-title-mvc",
    "kind": "razor",
    "titulo": "titulo da pagina Razor com sufixo MVC",
    "file": "edit-razor-title-mvc.md",
    "path": "app/Views/Home/Index.cshtml",
    "must_contain": ["<title>Frontpipe MVC</title>", "id=\"root\""],
    "must_not_contain": ["<title>Frontpipe</title>"],
    "no_regress": ["#titulo:font-size", "#quadro:rect_w"]
  },
  {
    "id": "react-painel-2026",
    "kind": "react",
    "titulo": "texto do painel no React com ano 2026",
    "file": "edit-react-painel-2026.md",
    "path": "app/wwwroot/js/app.js",
    "must_contain": ["Painel de vendas 2026", "createElement", "createRoot"]
  }
]
