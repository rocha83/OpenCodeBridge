@model IEnumerable<Rochas.AI.Manager.Domain.Harness.ModelBinding>
@{ ViewData["Title"] = "Model Bindings"; }
<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createModal">Novo</button>
<div class="table-responsive d-none d-md-block">
  <table class="table table-striped data-grid"><thead><tr><th>Provider</th><th>Modelo</th><th>MaxTokens</th></tr></thead>
  <tbody>@foreach(var m in Model){<tr><td>@m.Provider</td><td>@m.ModelId</td><td>@m.MaxTokens</td></tr>}</tbody></table>
</div>
<div class="d-md-none">@foreach(var m in Model){<div class="card mb-2"><div class="card-body"><h6>@m.Provider / @m.ModelId</h6><p>MaxTokens: @m.MaxTokens</p></div></div>}</div>
<div class="modal fade" id="createModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <form method="post" action="/ModelBindings/Create">@Html.AntiForgeryToken()
    <div class="modal-header"><h5 class="modal-title">Novo Model Binding</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><input name="provider" class="form-control mb-2" placeholder="Provider" required  required/><input name="modelId" class="form-control mb-2" placeholder="ModelId" required  required/></div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary">Salvar</button></div>
  </form>
</div></div></div>
