@using Rochas.AI.Manager.Domain.Interfaces
@model ReportQuery
@{
    ViewData["Title"] = "Relatórios";
}
<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header"><strong>Facetas</strong></div>
                <div class="card-body">
                    <form id="reportForm" method="get" action="/Reports/Preview" target="previewFrame">
                        <div class="mb-2">
                            <label class="form-label">Entidade</label>
                            <select name="Entity" class="form-select form-select-sm">
                                <option value="TrainingJob">TrainingJob</option>
                                <option value="Experiment">Experiment</option>
                                <option value="HarnessRun">HarnessRun</option>
                                <option value="TrainingWorkflowCard">TrainingWorkflowCard</option>
                                <option value="ModelArtifact">ModelArtifact</option>
                                <option value="Dataset">Dataset</option>
                                <option value="InstructionProfile">InstructionProfile</option>
                                <option value="HarnessProfile">HarnessProfile</option>
                                <option value="ToolPolicy">ToolPolicy</option>
                                <option value="ModelBinding">ModelBinding</option>
                                <option value="BridgeCapture">BridgeCapture</option>
                                <option value="User">User</option>
                                <option value="Agent">Agent</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Status</label>
                            <input type="text" name="Status" class="form-control form-control-sm" placeholder="ex: Completed" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">De</label>
                            <input type="date" name="DateFrom" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Até</label>
                            <input type="date" name="DateTo" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Eixo temporal</label>
                            <select name="DateAxis" class="form-select form-select-sm">
                                <option value="created_at">Criação</option>
                                <option value="started_at">Início</option>
                                <option value="completed_at">Conclusão</option>
                                <option value="updated_at">Atualização</option>
                            </select>
                            <div class="form-text">Eixos válidos dependem da entidade; inválido retorna 400.</div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Banda de Acurácia</label>
                            <select name="AccuracyBand" class="form-select form-select-sm">
                                <option value="">Todas</option>
                                <option value="low">Baixa (&lt;0.5)</option>
                                <option value="medium">Média (0.5-0.8)</option>
                                <option value="high">Alta (≥0.8)</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Família de Modelo</label>
                            <input type="text" name="ModelFamily" class="form-control form-control-sm" placeholder="Gemma4, Llama..." />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Página / Tamanho</label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="Page" value="1" class="form-control" />
                                <input type="number" name="PageSize" value="20" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">Preview</button>
                    </form>
                </div>
            </div>
            <div class="card mt-2">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-sm" onclick="exportFmt('csv')">Exportar CSV</button>
                        <button class="btn btn-success btn-sm" onclick="exportFmt('excel')">Exportar Excel</button>
                        <button class="btn btn-success btn-sm" onclick="exportFmt('pdf')">Exportar PDF (HTML)</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <iframe name="previewFrame" style="width:100%;height:70vh;border:1px solid #ccc;"></iframe>
        </div>
    </div>
</div>
<script>
function exportFmt(fmt) {
    var f = document.getElementById('reportForm');
    var params = new URLSearchParams(new FormData(f));
    params.set('format', fmt);
    window.location.href = '/Reports/Export?' + params.toString();
}
</script>