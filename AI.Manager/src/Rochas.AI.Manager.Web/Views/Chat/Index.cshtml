@{ Layout = "_Layout"; ViewData["Title"] = "Chat"; }
@{
    var agents = (IEnumerable<Rochas.AI.Manager.Domain.Entities.Agent>)ViewBag.Agents;
}
<section>
  <div class="container py-5">

    <div class="row">

      <div class="col-md-6 col-lg-4 col-xl-3 mb-4 mb-md-0">

        <div class="mb-3">
          <h5 class="font-weight-bold text-lg-start mb-2">Sessões</h5>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-info" id="newSession" data-mdb-button-init data-mdb-ripple-init>Nova</button>
            <button type="button" class="btn btn-warning" id="compactBtn" data-mdb-button-init data-mdb-ripple-init>Compactar</button>
            <button type="button" class="btn btn-danger text-black" id="clearSessions" data-mdb-button-init data-mdb-ripple-init>Limpar</button>
          </div>
          <span id="ctxWrap" class="ms-2 d-inline-block align-middle" title="Tamanho do contexto 0k">
            <svg id="ctxDonut" width="36" height="36" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="14" fill="none" stroke="#2a323d" stroke-width="5" />
              <circle id="ctxArc" cx="18" cy="18" r="14" fill="none" stroke="#14a44d" stroke-width="5"
                stroke-linecap="round" stroke-dasharray="0 88" transform="rotate(-90 18 18)" />
              <text id="ctxK" x="18" y="21.5" text-anchor="middle" font-size="9" fill="#e0e0e0">0k</text>
            </svg>
          </span>
        </div>

        <div class="card">
          <div class="card-body">
            <ul class="list-unstyled mb-0" id="sessionList"><li class="small text-muted">Carregando sessões...</li></ul>
          </div>
        </div>

      </div>

      <div class="col-md-6 col-lg-8 col-xl-6">

        <div class="mb-4">
          <select id="agentId" class="form-select form-select-sm" title="Orquestrador">
            @foreach (var a in agents)
            {
              <option value="@a.Id" data-mode="@(string.IsNullOrEmpty(a.Mode) ? "build" : a.Mode)" data-tools="@(a.Tools ?? "")">@a.Name — @a.Model</option>
            }
          </select>
          <select id="executorId" class="form-select form-select-sm mt-2" title="Executor (opcional)">
            <option value="">Executor: nenhum (chat simples)</option>
            @foreach (var a in agents)
            {
              <option value="@a.Id" data-mode="@(string.IsNullOrEmpty(a.Mode) ? "build" : a.Mode)" data-tools="@(a.Tools ?? "")">@a.Name — @a.Model</option>
            }
          </select>
          <div class="small text-muted mt-2"><span id="engineDot" class="dot"></span> <span id="engineTxt">Aguardando...</span></div>
        </div>

        <ul class="list-unstyled" id="conv" aria-live="polite" aria-atomic="false"></ul>

        <ul class="list-unstyled">
          <li class="mb-3">
            <label class="form-label fw-bold text-white" for="prompt">Pergunta ou Instrução</label>
            <div data-mdb-input-init class="form-outline mb-3">
              <textarea class="form-control bg-body-tertiary rounded-3" id="prompt" rows="4"></textarea>
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="autoApprove">
              <label class="form-check-label small text-white-50" for="autoApprove">Aprovar uso de ferramentas automaticamente</label>
            </div>
          </li>
          <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-info float-end" id="send">ENVIAR</button>
        </ul>

      </div>

      <div class="col-md-12 col-lg-12 col-xl-3">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Mudanças</h5>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <ul class="list-unstyled mb-0" id="changedList">
              <li class="small text-muted">Nenhum arquivo ainda.</li>
            </ul>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="font-weight-bold text-lg-start mb-0">Scripts para o Executor</h5>
        </div>

        <div class="card">
          <div class="card-body">
            <ul class="list-unstyled mb-0 scripts-list" id="scriptList">
              <li class="small text-muted">Nenhum script ainda.</li>
            </ul>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
<!-- Modal Arquivo (CodeMirror + diff lado a lado) -->
<div class="modal fade" id="fileModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-fullscreen-md-down">
    <div class="modal-content">
      <div class="modal-header flex-wrap gap-2">
        <h6 class="modal-title mb-0 text-truncate" id="fileModalTitle" style="max-width:40%">Arquivo</h6>
        <span id="fileModalKind" class="badge bg-info ms-2"></span>
        <span id="cmModeLbl" class="small text-muted ms-2"></span>
        <select id="cmTheme" class="form-select form-select-sm ms-2" style="width:auto" title="Tema do editor">
          <option value="default">Claro</option>
          <option value="material-darker">Material</option>
          <option value="monokai">Monokai</option>
          <option value="dracula">Dracula</option>
          <option value="eclipse">Eclipse</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-info ms-2" id="fileDiffBtn">Diff</button>
        <button type="button" class="btn btn-sm btn-success ms-2" id="fileSaveBtn">Salvar</button>
        <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body" id="fileModalBody">
        <div id="cmHost" style="border:1px solid #2a323d"></div>
        <div id="diffHost" class="mt-2"></div>
        <div id="fileMsg" class="small mt-2 text-muted"></div>
      </div>
    </div>
  </div>
</div>
<!-- MDB Toast container for errors -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;" id="toastContainer"></div>
@section Scripts {
<link href="~/lib/codemirror/codemirror.css" rel="stylesheet" />
<link href="~/lib/codemirror/theme/material-darker.css" rel="stylesheet" />
<link href="~/lib/codemirror/theme/monokai.css" rel="stylesheet" />
<link href="~/lib/codemirror/theme/dracula.css" rel="stylesheet" />
<link href="~/lib/codemirror/theme/eclipse.css" rel="stylesheet" />
<link href="~/lib/diff2html/diff2html.min.css" rel="stylesheet" />
<link href="~/lib/diff2html/highlight-dark.min.css" rel="stylesheet" />
<style>
/* Modal Arquivo contido na tela: corpo flex (editor 60 / diff 30), scrolls internos. */
#fileModal .modal-dialog { max-height: 94vh; margin-top: 3vh; margin-bottom: 3vh; }
#fileModal .modal-content { max-height: 94vh; display: flex; flex-direction: column; }
#fileModal .modal-body { height: 78vh; display: flex; flex-direction: column; gap: .5rem; min-height: 0; overflow: hidden; flex: 1 1 auto; padding: 1rem 1rem .3rem; }
#fileModal #fileMsg { margin-top: .25rem; margin-bottom: 0; }
#cmHost { flex: 1 1 auto; min-height: 12rem; overflow: hidden; }
.CodeMirror { height: 100%; font-size: 13px; }
#fileModalBody.with-diff #cmHost { flex: 0 1 60%; }
#diffHost { display: none; flex: 0 1 40%; min-height: 0; overflow: auto; }
#fileModalBody.with-diff #diffHost { display: block; }
#diffHost .d2h-wrapper { text-align: left; }
#diffHost .d2h-file-header { display: none; }
/* Código no tema claro: paleta GitHub light (o highlight-dark.min.css é só p/ dark). */
[data-bs-theme="light"] #diffHost .hljs { background: #fff; color: #24292e; }
[data-bs-theme="light"] #diffHost .hljs-keyword, [data-bs-theme="light"] #diffHost .hljs-doctag { color: #d73a49; }
[data-bs-theme="light"] #diffHost .hljs-string, [data-bs-theme="light"] #diffHost .hljs-regexp { color: #032f62; }
[data-bs-theme="light"] #diffHost .hljs-comment, [data-bs-theme="light"] #diffHost .hljs-quote { color: #6a737d; }
[data-bs-theme="light"] #diffHost .hljs-number, [data-bs-theme="light"] #diffHost .hljs-literal { color: #005cc5; }
[data-bs-theme="light"] #diffHost .hljs-title, [data-bs-theme="light"] #diffHost .hljs-section, [data-bs-theme="light"] #diffHost .hljs-function { color: #6f42c1; }
</style>
<script src="~/lib/codemirror/codemirror.js"></script>
<script src="~/lib/codemirror/mode/meta.js"></script>
<script src="~/lib/codemirror/mode/javascript.js"></script>
<script src="~/lib/codemirror/mode/xml.js"></script>
<script src="~/lib/codemirror/mode/css.js"></script>
<script src="~/lib/codemirror/mode/htmlmixed.js"></script>
<script src="~/lib/codemirror/mode/clike.js"></script>
<script src="~/lib/codemirror/mode/python.js"></script>
<script src="~/lib/codemirror/mode/shell.js"></script>
<script src="~/lib/codemirror/mode/markdown.js"></script>
<script src="~/lib/codemirror/mode/yaml.js"></script>
<script src="~/lib/codemirror/mode/sql.js"></script>
<script src="~/lib/diff2html/highlight.min.js"></script>
<script src="~/lib/diff2html/diff2html.min.js"></script>
<script>
const conv = document.getElementById('conv');
// Antiforgery p/ mutações: token injetado pelo layout.
function afToken() { try { const el = document.querySelector('input[name=__RequestVerificationToken]'); return el ? el.value : ''; } catch { return ''; } }
function afHeaders(extra) { const h = { 'Content-Type': 'application/json', 'RequestVerificationToken': afToken() }; if (extra) for (const k in extra) h[k] = extra[k]; return h; }
const sessionList = document.getElementById('sessionList');
const agentSel = document.getElementById('agentId');
const execSel = document.getElementById('executorId');
const engineDot = document.getElementById('engineDot');
const engineTxt = document.getElementById('engineTxt');
const toastContainer = document.getElementById('toastContainer');
let currentSessionId = null;
let currentAgentId = null;
let currentExecutorId = null;
let uiConfig = { directApprove: false, telemetry: false };
// Tracer injetável: observa os comportamentos autônomos (poll, init, select, stream)
// e envia o lote p/ a tabela Serilog quando a telemetria está ligada (Diagnostics).
const Tracer = (() => {
  let enabled = false, queue = [], timer = null, sid = 0;
  async function flush() {
    if (!enabled || !queue.length) return;
    const batch = queue.splice(0, 50);
    try {
      await fetch('/Chat/ClientLog', { method: 'POST', headers: afHeaders(),
        body: JSON.stringify({ sessionId: sid || null, events: batch }) });
    } catch { /* telemetria nunca quebra a UI */ }
  }
  function tick(source, level, msg, data) {
    let d;
    try { d = data === undefined ? undefined : String(JSON.stringify(data)).slice(0, 300); } catch { d = undefined; }
    if (enabled) {
      queue.push({ t: new Date().toISOString(), source, level, msg: String(msg || '').slice(0, 500), data: d });
      if (level === 'error' || queue.length >= 20) flush();
    }
    try { (console[level] || console.log).call(console, '[ui]', source, msg); } catch {}
  }
  return {
    init(opts) {
      enabled = !!(opts && opts.telemetry);
      if (enabled && !timer) timer = setInterval(flush, 8000);
    },
    session(id) { sid = id || 0; },
    debug(s, m, d) { if (enabled) tick(s, 'debug', m, d); },
    info(s, m, d) { tick(s, 'info', m, d); },
    warn(s, m, d) { tick(s, 'warn', m, d); },
    error(s, m, d) { tick(s, 'error', m, d); },
    flush
  };
})();
fetch('/Chat/Config').then(r => r.json()).then(j => { uiConfig.directApprove = !!j.directApprove; uiConfig.telemetry = !!j.telemetry; Tracer.init(uiConfig); }).catch(() => {});
const execIdOrNull = () => execSel.value ? +execSel.value : null;

// Stream ativo por sessão: trocar de sessão aborta o anterior (bolhas independentes).
function abortActiveStream() {
  try { window._streamAbort?.abort(); } catch {}
  if (window._streamSession) {
    fetch('/Chat/Stop', { method: 'POST', headers: afHeaders(),
      body: JSON.stringify({ sessionId: window._streamSession }) }).catch(() => {});
  }
  window._streamAbort = null; window._streamSession = null;
  window._ensureAgentBubbleForTools = null;
  document.getElementById('cancelBtn')?.remove();
  document.getElementById('processing-indicator')?.remove();
}

const avatarUser = '<span class="rounded-circle d-flex align-self-start ms-3 shadow-1-strong bg-secondary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-user fa-2x text-white"></i></span>';
const avatarAgent = '<span class="rounded-circle d-flex align-self-start me-3 shadow-1-strong bg-primary justify-content-center align-items-center" style="width:60px;height:60px"><i class="fas fa-robot fa-2x text-white"></i></span>';

function esc(s) { return (s || '').replace(/<\/?(details|summary)(\s[^>]*)?>/gi, '').replace(/\\"/g, '"').replace(/\\n/g, '\n').replace(/\\t/g, '\t').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

// % do thinking sobre o teto 8k (estimativa chars/4); ao vivo trava em 99, conclusão = 100.
function thinkAvg() {
  try { return parseFloat(localStorage.getItem('thinkAvg') || '6000') || 6000; }
  catch { return 6000; }
}
function thinkNote(total) {
  try {
    const prev = thinkAvg();
    localStorage.setItem('thinkAvg', String(Math.round(prev * 0.8 + total * 0.2)));
  } catch {}
}
// % calibrado pela média móvel do tamanho das respostas (thinking+conteúdo):
// resposta típica chega ~90%, salto final pequeno; 100% exato só no DONE.
function thinkPct(chars) { const k = Math.max(150, thinkAvg() / 19); return Math.min(99, Math.floor(100 * chars / (chars + k))); }

function showToast(message, type = 'danger') {
  const id = 'toast-' + Date.now();
  const bg = type === 'danger' ? 'bg-danger' : (type === 'success' ? 'bg-success' : 'bg-info');
  const icon = type === 'danger' ? 'fa-circle-exclamation' : (type === 'success' ? 'fa-circle-check' : 'fa-circle-info');
  const toastHtml = `
    <div id="${id}" class="toast ${bg} text-white" role="alert" aria-live="assertive" aria-atomic="true" data-mdb-delay="5000">
      <div class="toast-header ${bg} text-white border-0">
        <i class="fas ${icon} me-2"></i>
        <strong class="me-auto">Bridge Web</strong>
        <button type="button" class="btn-close btn-close-white" data-mdb-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body">${esc(message)}</div>
    </div>`;
  toastContainer.insertAdjacentHTML('beforeend', toastHtml);
  const toastEl = document.getElementById(id);
  if (toastEl) {
    const toast = new mdb.Toast(toastEl);
    toast.show();
    toastEl.addEventListener('hidden.mdb.toast', () => toastEl.remove());
  }
}

function isScrolledToBottom() {
  return conv.scrollTop + conv.clientHeight >= conv.scrollHeight - 50;
}

// Enunciado passado ao subagente (args {"prompt": "..."}); cai p/ head crua.
function subPromptOf(args) {
  try {
    const p = JSON.parse(args || '').prompt;
    if (p && p.trim()) return p.trim().replace(/\s+/g, ' ');
  } catch {}
  return (args || '').replace(/\s+/g, ' ').trim();
}
// Rótulo do arg por tool (comando/caminho/padrão em vez de JSON cru).
function labelHead(name, args) {
  try {
    const o = JSON.parse(args || '');
    const pick = { shell: 'command', read: 'path', write: 'path', edit: 'path',
      grep: 'pattern', glob: 'pattern', fetch: 'url', git: 'command' }[name];
    if (pick && o[pick]) return String(o[pick]).replace(/\s+/g, ' ').trim().slice(0, 120);
  } catch {}
  const a = (args || '').replace(/\s+/g, ' ').trim();
  return a.length > 80 ? a.slice(0, 80) + '…' : a;
}
// Grupo "Ferramentas" por bolha: dropdown abaixo do Raciocínio com uma
// sub-label (details) por tool executada. Individual por bolha (agente e sub).
function ensureToolsGroup(bodyEl) {
  let g = bodyEl.querySelector(':scope > details.tools-group');
  if (g) return g;
  g = document.createElement('details');
  g.className = 'mb-2 tools-group';
  // Aberto por padrão: o estado das tools ("executado com sucesso"/"falhou")
  // fica visível sem clique duplo e entra no texto da conversa (gate das faixas).
  g.setAttribute('open', '');
  g.innerHTML = `<summary class="small text-muted">Ferramentas</summary><div class="tlist"></div>`;
  const think = bodyEl.querySelector(':scope > details:not(.tools-group)');
  if (think) think.after(g);
  else {
    const pre = bodyEl.querySelector(':scope > pre');
    if (pre) pre.before(g); else bodyEl.prepend(g);
  }
  return g;
}
function bumpToolsCount(g) {
  const n = g.querySelectorAll(':scope > .tlist > details.tool-item').length;
  g.querySelector('summary').textContent = `Ferramentas (${n})`;
}
// Raciocínio sempre acima do grupo: insere o details do thinking antes dele.
function insertThinkFirst(det, refEl) {
  const body = refEl ? refEl.parentNode : null;
  if (!body) return;
  const g = body.querySelector(':scope > details.tools-group');
  if (g) body.insertBefore(det, g);
  else if (refEl && refEl.isConnected) body.insertBefore(det, refEl);
  else body.prepend(det);
}
// Dono do label: card do sub (sub) ou bolha do agente. Sem bolha ainda
// (tool antes de qualquer texto): abre a bolha p/ ancorar o grupo.
function toolsOwnerBody(sub) {
  if (sub) return ensureSubCard(sub).li.querySelector('.card-body');
  let bub = window._agentBubble;
  if (!bub || !bub.isConnected) {
    try { if (window._ensureAgentBubbleForTools) window._ensureAgentBubbleForTools(); } catch {}
    bub = window._agentBubble;
  }
  return (bub && bub.isConnected) ? bub.querySelector('.card-body') : null;
}
// Linha de status de tool dentro do grupo da bolha dona.
// sub: id do subagente dono (labels próprios, ancorados no card dele).
// Delegação externa (subagent sem id: o card ainda não existe) ancora no
// grupo do agente: sucesso não despeja o resultado (o card já mostra);
// falha sem card mostra o motivo (timeout/recusa ficavam invisíveis).
function toolConfirm(name, result, args, approveId, label) {
  // Card âmbar com Sim/Nao: o clique aprova sem mensagem na bolha.
  // Rótulo amigável da categoria ("Escrever em arquivos"); nome técnico
  // fica pequeno no detalhe (o usuário decide pelo rótulo).
  const body = toolsOwnerBody(null);
  if (!body) return;
  const g = ensureToolsGroup(body);
  const list = g.querySelector(':scope > .tlist');
  if (!list) return;
  const d = document.createElement('details');
  d.className = 'mb-1 tool-item';
  d.dataset.tool = name;
  d.setAttribute('open', '');
  const a = (args || '').replace(/\s+/g, ' ').trim().slice(0, 160);
  const lbl = (label || '').trim() || name;
  d.innerHTML = `<summary class="small text-warning">🔒 O agente está tentando <b>${esc(lbl)}</b>, você permite?</summary>`
    + `<div class="small text-muted">${esc(name)}${a ? ' ' + esc(a) : ''}</div>`
    + `<div class="mt-1 d-flex gap-2"><button class="btn btn-sm btn-success" data-ap="1">Sim</button>`
    + `<button class="btn btn-sm btn-danger text-black" data-ap="0">Não</button>`
    + `<span class="small text-muted">ou digite <b>pode fazer</b> no chat</span></div>`;
  const done = (txt) => {
    d.querySelectorAll('button').forEach(b => b.disabled = true);
    const s = document.createElement('div');
    s.className = 'small text-muted';
    s.textContent = txt;
    d.appendChild(s);
  };
  d.querySelectorAll('button').forEach(b => b.addEventListener('click', async () => {
    const approved = b.dataset.ap === '1';
    try {
      await fetch('/Chat/Approve', { method: 'POST', headers: afHeaders(),
        body: JSON.stringify({ sessionId: currentSessionId, approveId: approveId, approved: approved }) });
    } catch { /* timeout do loop decide */ }
    done(approved ? 'Aprovado — executando…' : 'Negado pelo usuário.');
  }));
  list.appendChild(d);
  bumpToolsCount(g);
}
function toolStatus(name, running, ok, result, ms, args, sub) {
  // Chamada de subagente ≠ execução: só placeholder/card (sem grupo).
  if (name === 'subagent' && !sub) {
    if (running) subPlaceholder(subPromptOf(args));
    else settlePlaceholder(name, ok, result);
    return;
  }
  const body = toolsOwnerBody(sub);
  if (!body) return;
  const g = ensureToolsGroup(body);
  const list = g.querySelector(':scope > .tlist');
  if (running) {
    const d = document.createElement('details');
    d.className = 'mb-1 tool-item';
    d.dataset.tool = name;
    d.dataset.busy = '1';
    d.setAttribute('open', '');
    const a = (args || '').replace(/\s+/g, ' ').trim();
    const head = labelHead(name, args);
    // Sem duplicar: start repetido do mesmo args reutiliza o item ocupado.
    let dup = null;
    list.querySelectorAll('details.tool-item').forEach(el => {
      if (!dup && el.dataset.tool === name && el.dataset.busy === '1' && (el.dataset.args || '') === head) dup = el;
    });
    if (dup) { bumpToolsCount(g); return; }
    // Tool real: label com comando/caminho + item no grupo.
    d.innerHTML = `<summary class="small text-muted">Executando ${esc(name)}${head ? ' ' + esc(head) : ''}…</summary>`;
    d.dataset.args = head;
    list.appendChild(d);
    bumpToolsCount(g);
  } else {
    let d = null;
    const ahead = args ? labelHead(name, args) : '';
    list.querySelectorAll('details.tool-item').forEach(el => {
      if (!d && el.dataset.tool === name && el.dataset.busy === '1'
        && (!ahead || (el.dataset.args || '') === ahead)) d = el;
    });
    if (!d) list.querySelectorAll('details.tool-item').forEach(el => {
      if (!d && el.dataset.tool === name) d = el;
    });
    if (!d) {
      d = document.createElement('details');
      d.className = 'mb-1 tool-item';
      d.dataset.tool = name;
      list.appendChild(d);
    }
    const state = ok === false ? 'falhou' : 'executado com sucesso';
    const p = result ? `<p class="small text-muted">${esc(result)}</p>` : '';
    const ah = d.dataset.args ? ` <span class="text-muted">${esc(d.dataset.args)}</span>` : '';
    d.dataset.busy = '';
    d.innerHTML = `<summary class="small text-muted">${esc(name)} ${state}.${ah}</summary>${p}`;
    d.removeAttribute('open');
    bumpToolsCount(g);
  }
  if (isScrolledToBottom()) scrollToBottom();
}

function scrollToBottom() {
  conv.scrollTo({ top: conv.scrollHeight, behavior: 'smooth' });
}

// Card ao vivo do subagente: abre no primeiro thinking/chunk/tool dele,
// com % e digitação como o principal (execução dos subs é serial).
function ensureSubCard(sub) {
  window._subCards = window._subCards || {};
  // Placeholder do "digitando" adotado pelo sub real (sem duplicar).
  if (sub && window._pendingSubCard && window._pendingSubCard.li.isConnected && window._pendingSubCard.pending) {
    const h = window._pendingSubCard;
    h.pending = false; window._pendingSubCard = null;
    h.li.dataset.sub = sub;
    window._subCards[sub] = h;
    window._currentSubCard = h;
    return h;
  }
  if (sub && window._subCards[sub] && window._subCards[sub].li.isConnected) {
    window._currentSubCard = window._subCards[sub];
    return window._subCards[sub];
  }
  const cur = window._currentSubCard;
  if (!sub && cur && cur.li.isConnected) return cur;
  const card = document.createElement('li');
  card.className = 'd-flex justify-content-between mb-4 subagent-card';
  if (sub) card.dataset.sub = sub;
  card.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Sub Agente</p>
        </div>
        <div class="card-body">
          <pre class="mb-0 subans rawbox"></pre>
          <div class="msg-ts">${fmtTs(new Date().toISOString())}</div>
        </div>
      </div>`;
  // Pilha LIFO acima da bolha: o mais recente entra no topo (antes do anterior).
  const prev = window._lastSubCard;
  if (prev && prev.isConnected) prev.before(card);
  else {
    const bub = window._agentBubble;
    if (bub && bub.isConnected) conv.insertBefore(card, bub);
    else conv.appendChild(card);
  }
  window._lastSubCard = card;
  (window._liveSubs = window._liveSubs || []).push(card);
  const h = { li: card, pre: card.querySelector('.subans'), det: null, psum: null, pp: null, think: '', full: '' };
  window._currentSubCard = h;
  if (sub) window._subCards[sub] = h;
  return h;
}

// Placeholder imediato no "digitando" (delegação anunciada, sub ainda em
// prefill): o primeiro subChunk do sub real adota este card.
function subPlaceholder(prompt) {
  if (window._pendingSubCard && window._pendingSubCard.li.isConnected) return;
  const h = ensureSubCard(null);
  h.pending = true;
  window._pendingSubCard = h;
  h.pre.textContent = '';
  h.pre.classList.add('typing');
  // Enunciado da delegação em dropdown próprio (chamada ≠ execução).
  if (prompt) {
    const det = document.createElement('details');
    det.className = 'mb-2 subprompt';
    det.setAttribute('open', '');
    det.innerHTML = `<summary class="small text-muted">Enunciado</summary><p class="small text-muted"></p>`;
    det.querySelector('p').textContent = prompt;
    h.pre.parentNode.insertBefore(det, h.pre);
    h.promptDet = det;
  }
  if (isScrolledToBottom()) scrollToBottom();
}
// Finaliza placeholder nunca adotado (sub falhou antes do primeiro chunk).
function settlePlaceholder(name, ok, result) {
  const h = window._pendingSubCard;
  if (!h || !h.li.isConnected || !h.pending) return;
  h.pending = false; window._pendingSubCard = null;
  h.pre.classList.remove('typing');
  h.pre.textContent = ok === false ? ('Falhou: ' + (result || name)) : (result || '');
  h.painted = true;
  if (window._currentSubCard === h) window._currentSubCard = null;
}

// Chunk ao vivo do subagente (thinking/content): paridade com o principal.
function subChunk(sub, kind, text) {
  if (!sub) return;
  const h = ensureSubCard(sub);
  if (h.painted) return; // done já pintou: chunk tardio não reabre nem duplica.
  if (kind === 'thinking') {
    h.think += text;
    if (!h.det) {
      h.det = document.createElement('details');
      h.det.className = 'mb-2';
      h.det.innerHTML = `<summary class="small text-muted">Raciocínio 0%</summary>`;
      h.psum = h.det.querySelector('summary');
      h.pp = document.createElement('p');
      h.pp.className = 'small text-muted typing';
      h.det.appendChild(h.pp);
      insertThinkFirst(h.det, h.pre);
    }
    h.pp.textContent = h.think;
    if (h.psum) h.psum.textContent = `Raciocínio ${thinkPct(h.think.length + h.full.length)}% · ${fmtK(h.think.length + h.full.length)}`;
    h.pp.scrollTop = h.pp.scrollHeight;
  } else {
    h.full += text;
    h.pre.classList.remove('typing');
    // Sem salto inicial (paridade com a bolha do agente): enquanto só há
    // espaço, apara a frente; texto real nunca é tocado.
    if (!h.full.trim()) h.full = '';
    else h.full = h.full.replace(/^\s+/, '');
    h.pre.textContent = h.full;
    h.pre.scrollTop = h.pre.scrollHeight;
    // Conteúdo começou (o % segue subindo; sem fechar à força — o usuário
    // pode abrir o Raciocínio durante o stream).
    if (h.psum) h.psum.textContent = `Raciocínio ${thinkPct(h.think.length + h.full.length)}% · ${fmtK(h.think.length + h.full.length)}`;
  }
  if (isScrolledToBottom()) scrollToBottom();
}

async function loadSessions() {
  const r = await fetch('/Chat/Sessions');
  if (!r.ok) { location.href = '/Account/Login'; return []; }
  const list = await r.json();
  sessionList.innerHTML = '';
  list.forEach(s => {
    const li = document.createElement('li');
    li.className = 'p-2 border-bottom' + (s.id === currentSessionId ? ' bg-body-tertiary' : '');
    const updated = new Date(s.createdAt).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    li.innerHTML = `<a href="#!" class="d-flex justify-content-between text-decoration-none">
      <div class="d-flex flex-row">
        <span class="rounded-circle d-flex align-self-center me-2 shadow-1-strong bg-info justify-content-center align-items-center" style="width:38px;height:38px"><i class="fas fa-comments text-white"></i></span>
        <div class="pt-1">
          <p class="small fw-bold mb-0 text-truncate" style="max-width:200px">${esc(s.title)}</p>
          <p class="small text-muted mb-0">${updated}</p>
        </div>
      </div>
      <span class="align-self-center text-danger del-session" title="Excluir" style="cursor:pointer"><i class="fas fa-trash-alt"></i></span>
    </a>`;
