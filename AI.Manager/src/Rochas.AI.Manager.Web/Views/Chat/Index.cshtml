async function selectSession(id, agentId, executorAgentId) {
  try {
  if (window._streamSession && window._streamSession !== id) abortActiveStream();
  try { document.getElementById('prompt').value = ''; } catch {} // caixa é efêmera: nunca atravessa sessões
  currentSessionId = id;
  Tracer.session(id);
  try { localStorage.setItem('bridgeSessionId', String(id)); } catch {}
  currentAgentId = agentId;
  agentSel.value = agentId;
  currentExecutorId = executorAgentId ?? null;
  applyExecutorAvailability();
  execSel.value = currentExecutorId ?? '';
  await loadMessages(id);
  await loadSessions();
  await syncAutoApprove(id);
  checkEngine();
  updateCtxDonut();
  loadScripts(id);
  loadChangedFiles(id);
  Tracer.info('ui:select', 'sessao ' + id);
  } catch (e) { Tracer.error('ui:select', (e && e.message) || e); showToast('Falha ao trocar de sessão.', 'danger'); }
}

// Donut do tamanho do contexto da sessão ativa (tokens chars/4 vs orçamento).
function fmtK(t) { return t >= 1000 ? (Math.round(t / 100) / 10) + 'k' : String(t); }
async function updateCtxDonut() {
  const arc = document.getElementById('ctxArc'), lab = document.getElementById('ctxK'),
    wrap = document.getElementById('ctxWrap');
  if (!arc || !lab || !wrap) return;
  if (!currentSessionId) {
    arc.setAttribute('stroke-dasharray', '0 88'); arc.setAttribute('stroke', '#14a44d');
    lab.textContent = '0k'; wrap.title = 'Tamanho do contexto 0k'; return;
  }
  try {
    const r = await fetch(`/Chat/Sessions/${currentSessionId}/Context`);
    if (!r.ok) return;
    const j = await r.json();
    const est = +j.tokens || 0, b = +j.budget || 1;
    const t = +j.real > 0 ? (+j.real + (+j.newer || 0)) : est;
    const mode = +j.real > 0 ? 'medido' + ((+j.newer || 0) > 0 ? '+delta' : '') : 'estimado';
    const frac = Math.min(1, t / b), C = 88;
    arc.setAttribute('stroke-dasharray', `${(frac * C).toFixed(1)} ${C}`);
    arc.setAttribute('stroke', frac >= 0.9 ? '#dc4c64' : frac >= 0.7 ? '#e4a11b' : '#14a44d');
    lab.textContent = fmtK(t);
    wrap.title = 'Tamanho do contexto ' + fmtK(t) + ` (${mode})`;
  } catch (e) { Tracer.warn('ui:donut', (e && e.message) || e); }
}

async function loadMessages(sessionId) {
  const r = await fetch(`/Chat/Sessions/${sessionId}/Messages`);
  const msgs = await r.json();
  const wasAtBottom = isScrolledToBottom();
  conv.innerHTML = '';
  // Toda msg renderiza: falha isolada vira bolha bruta, nunca aborta a conversa.
  // Junção: assistant só-thinking (turno de delegação) não abre bolha própria;
  // o thinking incorpora na próxima bolha do agente com texto.
  // Histórico com subagentes e content vazio: preenche com a frase de fecho.
  const hasSub = (msgs || []).some(m => m?.role === 'subagent');
  // Tools por bolha (message_id; subagent externo tem card próprio e sai).
  let toolsByMsg = {};
  try {
    const rt = await fetch(`/Chat/Sessions/${sessionId}/ToolCalls?limit=500`);
    if (rt.ok) {
      const calls = await rt.json();
      (calls || []).forEach(c => {
        const mid = c?.messageId;
        if (!mid) return;
        (toolsByMsg[mid] = toolsByMsg[mid] || []).push(c);
      });
    }
  } catch { /* histórico sem tools: segue só texto */ }
  let pendingThink = '';
  (msgs || []).forEach(m => {
    try {
      const role = m?.role ?? 'assistant';
      const think = m?.thinking ?? '';
      let body = m?.content ?? '';
      if (role === 'assistant' && !(body || '').trim() && hasSub)
        body = 'As tarefas delegadas aos subagentes foram concluídas.';
      if (role === 'assistant' && !(body || '').trim() && (think || '').trim()) {
        pendingThink += (pendingThink ? '\n\n' : '') + think.trim();
        return;
      }
      if (role === 'assistant' && pendingThink.trim()) {
        const merged = pendingThink + ((think || '').trim() ? '\n\n' + think.trim() : '');
        pendingThink = '';
        conv.appendChild(msgItem(role, merged, body, m?.createdAt, toolsByMsg[m?.id], m?.elapsedMs, m?.tps, m?.status));
        return;
      }
      conv.appendChild(msgItem(role, think, body, m?.createdAt, toolsByMsg[m?.id], m?.elapsedMs, m?.tps, m?.status));
    } catch (err) {
      const li = document.createElement('li');
      li.className = 'd-flex justify-content-between mb-4';
      li.innerHTML = `${avatarAgent}<div class="card w-100"><div class="card-header d-flex justify-content-between p-3"><p class="fw-bold mb-0">Agente</p></div><div class="card-body"><pre class="mb-0 ans rawbox">${esc(String(m?.content ?? ''))}</pre></div></div>`;
      conv.appendChild(li);
    }
  });
  // Sobra sem bolha posterior: anexa ao último Agente em vez de bolha vazia.
  if (pendingThink.trim()) {
    const cards = [...conv.querySelectorAll('.card')].filter(c =>
      c.querySelector('.card-header p')?.textContent === 'Agente');
    const last = cards.pop();
    if (last) {
      const det = document.createElement('details');
      det.className = 'mb-2';
      det.innerHTML = `<summary class="small text-muted">Raciocínio 100%</summary>`;
      const p = document.createElement('p');
      p.className = 'small text-muted';
      p.textContent = pendingThink.trim();
      det.appendChild(p);
      last.querySelector('.card-body')?.prepend(det);
    } else {
      conv.appendChild(msgItem('assistant', pendingThink, '', undefined, undefined, undefined, undefined, ''));
    }
  }
  if (wasAtBottom) scrollToBottom();
  await loadTasks(sessionId);
}

// Painel lateral: scripts .sh gerados na sessão (do histórico tool_calls).
async function loadScripts(sessionId) {
  const list = document.getElementById('scriptList');
  if (!list) return;
  try {
    const r = await fetch(`/Chat/Sessions/${sessionId}/Scripts`);
    if (sessionId !== currentSessionId) return; // resposta de sessão trocada: descarta
    if (!r.ok) return;
    const j = await r.json();
    if (!j.scripts || !j.scripts.length) {
      list.innerHTML = '<li class="small text-muted">Nenhum script ainda.</li>';
    } else {
      list.innerHTML = '';
      j.scripts.forEach(s => {
        const li = document.createElement('li');
        li.className = 'mb-1';
        const p = (s && s.path) || s;
        const eta = (s && s.etaMin) ? ` <span class="small text-muted">· ~${esc(String(s.etaMin))} min</span>` : '';
        li.innerHTML = `<span class="badge bg-dark">${esc(p)}</span>${eta}`;
        list.appendChild(li);
      });
    }
    const zip = document.getElementById('scriptZip');
    if (j.zip && j.zip.name) {
      if (!zip) {
        const a = document.createElement('a');
        a.id = 'scriptZip';
        a.className = 'small';
        list.parentNode.appendChild(a);
      }
      const a2 = document.getElementById('scriptZip');
      a2.href = `/Chat/Sessions/${sessionId}/ScriptsZip`;
      a2.textContent = `Baixar scripts (.zip, ${j.zip.size || ''})`;
    } else if (zip) zip.remove();
  } catch (e) { Tracer.warn('ui:scripts', (e && e.message) || e); }
}

// Painel lateral: arquivos alterados na sessão (write/edit ok).
async function loadChangedFiles(sessionId) {
  const list = document.getElementById('changedList');
  if (!list) return;
  try {
    const r = await fetch(`/Chat/Sessions/${sessionId}/ChangedFiles`);
    if (sessionId !== currentSessionId) return; // resposta de sessão trocada: descarta
    if (!r.ok) return;
    const arr = await r.json();
    if (!arr || !arr.length) {
      list.innerHTML = '<li class="small text-muted">Nenhum arquivo ainda.</li>';
      return;
    }
    list.innerHTML = '';
    arr.forEach(f => {
      const li = document.createElement('li');
      li.className = 'mb-1';
      const badge = f.kind === 'novo' ? 'bg-success' : 'bg-warning text-dark';
      const short = esc(f.path.length > 34 ? '…' + f.path.slice(-33) : f.path);
      li.innerHTML = `<a href="#!" class="d-flex justify-content-between align-items-center text-decoration-none" title="${esc(f.path)}">
        <span class="small text-truncate text-info" style="max-width:200px">${short}</span>
        <span class="badge ${badge} ms-1">${esc(f.kind || '')}</span></a>`;
      li.querySelector('a').onclick = (e) => { e.preventDefault(); openFileModal(sessionId, f.path, f.kind); };
      list.appendChild(li);
    });
  } catch (e) { Tracer.warn('ui:changed', (e && e.message) || e); }
}

// Modal de arquivo: CodeMirror (temas + modos por extensão) + diff lado a lado.
let cm = null, cmPath = '', cmSession = 0, cmShowingDiff = false;
function cmThemeGet() { try { return localStorage.getItem('bridgeCmTheme') || 'material-darker'; } catch { return 'material-darker'; } }
function ensureCM() {
  if (cm) return cm;
  cm = CodeMirror(document.getElementById('cmHost'), { lineNumbers: true, theme: cmThemeGet(), indentUnit: 2, tabSize: 2 });
  const sel = document.getElementById('cmTheme');
  if (sel) {
    sel.value = cmThemeGet();
    sel.onchange = () => { try { localStorage.setItem('bridgeCmTheme', sel.value); } catch {} cm.setOption('theme', sel.value); };
  }
  return cm;
}
function cmModeFor(path) {
  try {
    const name = (path || '').split('/').pop();
    const info = CodeMirror.findModeByFileName(name);
    if (info && (info.mime || info.mode)) return info.mime || info.mode;
  } catch {}
  return null;
}
function fileMsg(t, cls) {
  const el = document.getElementById('fileMsg');
  el.textContent = t || '';
  el.className = 'small mt-2 ' + (cls || 'text-muted');
}
async function openFileModal(sessionId, path, kind) {
  cmSession = sessionId; cmPath = path; cmShowingDiff = false;
  document.getElementById('diffHost').style.display = 'none';
  document.getElementById('fileModalBody').classList.remove('with-diff');
  fileMsg('');
  document.getElementById('fileModalTitle').textContent = path;
  const kb = document.getElementById('fileModalKind');
  kb.textContent = kind || '';
  kb.className = 'badge ms-2 ' + (kind === 'novo' ? 'bg-success' : 'bg-warning text-dark');
  document.getElementById('fileDiffBtn').textContent = 'Diff';
  ensureCM();
  try {
    const r = await fetch(`/Chat/Sessions/${sessionId}/File?path=${encodeURIComponent(path)}`);
    if (!r.ok) { fileMsg('Falha ao carregar (' + r.status + ')', 'text-danger'); return; }
    const j = await r.json();
    cm.setValue(j.content || '');
    const mode = cmModeFor(path);
    cm.setOption('mode', mode);
    document.getElementById('cmModeLbl').textContent = mode || 'texto';
    cm.refresh();
  } catch { fileMsg('Falha ao carregar', 'text-danger'); return; }
  const el = document.getElementById('fileModal');
  if (window.mdb && mdb.Modal) mdb.Modal.getOrCreateInstance(el).show();
  else { el.style.display = 'block'; el.classList.add('show'); }
}
document.getElementById('fileSaveBtn').onclick = async () => {
  if (!cm || !cmSession || !cmPath) return;
  fileMsg('Salvando...');
  try {
    const r = await fetch(`/Chat/Sessions/${cmSession}/File`, {
      method: 'POST', headers: afHeaders(),
      body: JSON.stringify({ path: cmPath, content: cm.getValue() })
    });
    if (!r.ok) { fileMsg('Falha ao salvar (' + r.status + ')', 'text-danger'); return; }
    fileMsg('Salvo.', 'text-success');
    await loadChangedFiles(cmSession);
  } catch { fileMsg('Falha ao salvar', 'text-danger'); }
};
document.getElementById('fileDiffBtn').onclick = async () => {
  const host = document.getElementById('diffHost');
  if (cmShowingDiff) { host.style.display = 'none'; document.getElementById('fileModalBody').classList.remove('with-diff'); cmShowingDiff = false; document.getElementById('fileDiffBtn').textContent = 'Diff'; try { cm.refresh(); } catch {} return; }
  await loadDiff();
};
async function loadDiff() {
  const host = document.getElementById('diffHost');
  const scheme = (document.documentElement.getAttribute('data-bs-theme') || 'dark') === 'dark' ? 'dark' : 'light';
  fileMsg('Carregando diff...');
  try {
    const r = await fetch(`/Chat/Sessions/${cmSession}/FileDiff?path=${encodeURIComponent(cmPath)}`);
    const j = await r.json();
    if (!j.diff) { fileMsg(j.message || 'Sem diff', 'text-warning'); return; }
    host.innerHTML = Diff2Html.html(j.diff, { outputFormat: 'side-by-side', drawFileList: false, matching: 'lines', colorScheme: scheme });
    try { if (window.hljs) hljs.highlightAll(); } catch {}
    host.style.display = 'block';
    document.getElementById('fileModalBody').classList.add('with-diff');
    try { cm.refresh(); } catch {}
    cmShowingDiff = true;
    document.getElementById('fileDiffBtn').textContent = 'Código';
    fileMsg('');
  } catch { fileMsg('Falha no diff', 'text-danger'); }
}
// Diff acompanha o tema do site (fundo claro/escuro; verdes do diff intactos).
document.getElementById('themeToggle')?.addEventListener('click', () => { if (cmShowingDiff) loadDiff(); });

// Painel lateral: decomposição + status das mini-tarefas dos executores
async function loadTasks(sessionId) {
  const list = document.getElementById('taskList');
  if (!list) return; // painel de tarefas removido (só scripts).
  try {
    const r = await fetch(`/Chat/Sessions/${sessionId}/Tasks`);
    if (!r.ok) return;
    const j = await r.json();
    if (!j.tasks || !j.tasks.length) {
      list.innerHTML = '<li class="small text-muted">Sem decomposição nesta sessão.</li>';
      return;
    }
    list.innerHTML = '';
    let totalEta = 0;
    j.tasks.forEach(t => {
      const li = document.createElement('li');
      li.className = 'mb-2';
      const badge = t.status === 'done'
        ? '<span class="badge bg-success">concluída</span>'
        : t.status === 'running'
          ? '<span class="badge bg-info"><span class="spinner-border spinner-border-sm me-1"></span>executando</span>'
          : '<span class="badge bg-secondary">pendente</span>';
      const eta = t.etaMin > 0 ? ` <span class="text-muted">~${t.etaMin} min</span>` : '';
      if (t.etaMin > 0) totalEta += t.etaMin;
      const summary = t.promptSummary ? `<div class="small text-muted mt-1">${esc(t.promptSummary)}</div>` : '';
      const tools = (t.toolCalls && t.toolCalls.length)
        ? `<div class="mt-1">${t.toolCalls.map(c => `<span class="badge bg-dark me-1">${esc(c)}</span>`).join('')}</div>`
        : '';
      li.innerHTML = `<div class="small fw-bold">${t.index}. ${esc(t.title)}${eta}</div>${summary}${tools}<div class="mt-1">${badge}</div>`;
      list.appendChild(li);
    });
    if (totalEta > 0) {
      const li = document.createElement('li');
      li.className = 'mt-1 mb-2';
      li.innerHTML = `<span class="small text-muted">Total estimado: ~${Math.round(totalEta * 10) / 10} min</span>`;
      list.appendChild(li);
    }
    if (j.synthesized) {
      const li = document.createElement('li');
      li.className = 'mt-2';
      li.innerHTML = '<span class="badge bg-primary">síntese pronta</span>';
      list.appendChild(li);
    }
  } catch (e) { Tracer.warn('ui:tasks', (e && e.message) || e); }
}

// Atualiza o painel a cada 5s enquanto há sessão ativa
// Tick: SOMENTE parciais do painel direito (tarefas, scripts, Mudanças). Nada de
// conversa/lista aqui; donut atualiza no select/envio. Falha isolada por painel.
setInterval(() => {
  if (!currentSessionId) return;
  try {
    Promise.resolve(loadTasks(currentSessionId)).catch(e => Tracer.warn('poll:tasks', (e && e.message) || e));
    Promise.resolve(loadScripts(currentSessionId)).catch(e => Tracer.warn('poll:scripts', (e && e.message) || e));
    Promise.resolve(loadChangedFiles(currentSessionId)).catch(e => Tracer.warn('poll:changed', (e && e.message) || e));
  } catch (e) { Tracer.error('poll:tick', (e && e.message) || e); }
}, 5000);

async function createSession() {
  try {
  abortActiveStream();
  const r = await fetch('/Chat/Sessions', {
    method: 'POST',
    headers: afHeaders(),
    body: JSON.stringify({ agentId: +agentSel.value, executorAgentId: execIdOrNull(), title: 'Nova sessão' })
  });
  const s = await r.json();
  currentSessionId = s.id;
  Tracer.session(s.id);
  try { localStorage.setItem('bridgeSessionId', String(s.id)); } catch {}
  try { document.getElementById('prompt').value = ''; } catch {}
  try { const aa = document.getElementById('autoApprove'); if (aa) aa.checked = false; } catch {}
  currentAgentId = s.agentId;
  agentSel.value = s.agentId;
  currentExecutorId = s.executorAgentId ?? null;
  applyExecutorAvailability();
  execSel.value = currentExecutorId ?? '';
  await loadSessions();
  conv.innerHTML = '';
  document.getElementById('scriptList').innerHTML = '<li class="small text-muted">Nenhum script ainda.</li>';
  document.getElementById('scriptZip')?.remove();
  updateCtxDonut();
  checkEngine();
  Tracer.info('ui:create', 'sessao ' + s.id);
  } catch (e) { Tracer.error('ui:create', (e && e.message) || e); showToast('Falha ao criar sessão.', 'danger'); }
}

async function deleteAllSessions() {
  if (!confirm('Excluir todas as sessões?')) return;
  const r = await fetch('/Chat/Sessions');
  const list = await r.json();
  for (const s of list) {
    await fetch(`/Chat/Sessions/${s.id}`, { method: 'DELETE', headers: afHeaders() });
  }
  currentSessionId = null;
  currentAgentId = null;
  currentExecutorId = null;
  try { localStorage.removeItem('bridgeSessionId'); } catch {}
  await loadSessions();
  conv.innerHTML = '';
}

function fmtTs(iso) {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    const p = n => String(n).padStart(2, '0');
    return `${p(d.getDate())}/${p(d.getMonth() + 1)} ${p(d.getHours())}:${p(d.getMinutes())}`;
  } catch { return ''; }
}
// Rodapé da bolha: "13/10 10:44 - 143s - 15 t/s" (duração e t/s só quando medidos).
function fmtFoot(ts, ms, tps) {
  const base = fmtTs(ts);
  const parts = [base];
  if (+ms > 0) parts.push(`${Math.round(+ms / 1000)}s`);
  if (+tps > 0) parts.push(`${(+tps % 1 === 0) ? +tps : (+tps).toFixed(1)} t/s`);
  return parts.filter(Boolean).join(' - ');
}
function toolsGroupHtml(tools) {
  if (!tools || !tools.length) return '';
  const items = tools.map(c => {
    // Chamada de subagente não entra no grupo (tem card próprio).
    if (c?.name === 'subagent' && !c?.sub) return '';
    const state = c?.ok === false ? 'falhou' : 'executado com sucesso';
    const out = c?.output ? `<p class="small text-muted">${esc(c.output)}</p>` : '';
    const a = labelHead(c?.name, c?.args);
    const ah = a ? ` <span class="text-muted">${esc(a)}</span>` : '';
    return `<details class="mb-1 tool-item"><summary class="small text-muted">${esc(c?.name ?? 'tool')} ${state}.${ah}</summary>${out}</details>`;
  }).join('');
  return `<details class="mb-2 tools-group" open><summary class="small text-muted">Ferramentas (${tools.length})</summary><div class="tlist">${items}</div></details>`;
}
function msgItem(role, think, body, ts, tools, ms, tps, status) {
  const li = document.createElement('li');
  li.className = 'd-flex justify-content-between mb-4';
  const foot = ts ? `<div class="d-flex justify-content-between align-items-center"><span class="msg-st small text-muted">${esc(status || '')}</span><div class="msg-ts">${esc(fmtFoot(ts, ms, tps))}</div></div>` : '';
  if (role === 'user') {
    li.innerHTML = `
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Você</p>
        </div>
        <div class="card-body"><p class="mb-0 text-wrap">${esc(body)}</p>${foot}</div>
      </div>
      ${avatarUser}`;
  } else if (role === 'subagent') {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Sub Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio 100%</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${toolsGroupHtml(tools)}
          ${(body || '').trim() ? `<pre class="mb-0 subans rawbox">${esc(body)}</pre>` : ''}
          ${foot}
        </div>
      </div>`;
  } else {
    li.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          ${think ? `<details class="mb-2"><summary class="small text-muted">Raciocínio 100%</summary><p class="small text-muted">${esc(think)}</p></details>` : ''}
          ${toolsGroupHtml(tools)}
          ${(body || '').trim() ? `<pre class="mb-0 ans rawbox">${esc(body)}</pre>` : ''}
          ${foot}
        </div>
      </div>`;
  }
  return li;
}

agentSel.onchange = () => { currentAgentId = +agentSel.value; filterExecutors(); checkEngine(); runCalibration(); };

// Calibragem invisível ao selecionar o modelo: luz amarela "Calibrando..."
// enquanto o servidor sossega o delírio; nada pinta bolha nem grava sessão.
let calibSeq = 0;
async function runCalibration() {
  const my = ++calibSeq;
  const id = +agentSel.value || 0;
  if (!id) return;
  engineDot.className = 'dot calib blink'; engineTxt.textContent = 'Calibrando...';
  try {
    const r = await fetch('/Chat/Calibrate', { method: 'POST', headers: afHeaders(), body: JSON.stringify({ agentId: id }) });
    if (my !== calibSeq) return;
    if (!r.ok) throw new Error('http ' + r.status);
    const j = await r.json();
    engineDot.className = 'dot';
    engineTxt.textContent = ('Pronto! ' + (j.decode || '')).trim();
  } catch { if (my === calibSeq) { engineDot.className = 'dot'; engineTxt.textContent = 'Pronto!'; } }
}

// Executor lista todos, sem amarra de modo (plan+build é topologia válida).
function orchMode() {
  const opt = agentSel.selectedOptions[0];
  return opt ? (opt.dataset.mode || 'build') : 'build';
}
function filterExecutors() {
  const orch = +agentSel.value || 0;
  [...execSel.options].forEach(o => { o.hidden = o.value ? (+o.value === orch) : false; });
  // Orquestrador nunca é seu próprio executor (o servidor recusa com 400).
  if (execSel.value && +execSel.value === orch) { execSel.value = ''; currentExecutorId = null; }
  execSel.disabled = ![...execSel.options].some(o => o.value);
}

// Orquestrador sem permissão de subagent: combo de executor vem sem seleção e inativa.
function orchestratorCanDelegate() {
  try {
    const o = agentSel.selectedOptions && agentSel.selectedOptions[0];
    const csv = (o && o.dataset.tools) || '';
    return csv.split(',').map(s => s.trim().toLowerCase()).includes('subagent');
  } catch { return false; }
}
async function applyExecutorAvailability() {
  filterExecutors();
  if (orchestratorCanDelegate()) return;
  const had = currentExecutorId != null;
  execSel.value = '';
  execSel.disabled = true;
  currentExecutorId = null;
  if (currentSessionId && had) {
    try {
      await fetch(`/Chat/Sessions/${currentSessionId}/Executor`, {
        method: 'PUT', headers: afHeaders(),
        body: JSON.stringify({ executorAgentId: null })
      });
    } catch {}
  }
}

execSel.onchange = async () => {
  currentExecutorId = execIdOrNull();
  if (!currentSessionId) return;
  const r = await fetch(`/Chat/Sessions/${currentSessionId}/Executor`, {
    method: 'PUT',
    headers: afHeaders(),
    body: JSON.stringify({ executorAgentId: currentExecutorId })
  });
  if (!r.ok) {
    // Erro real do servidor (ex.: "Executor deve diferir do orquestrador"),
    // sem máscara genérica; BadRequest(string) pode vir entre aspas JSON.
    let msg = 'Executor inválido para esta sessão.';
    try {
      let t = (await r.text()).trim().replace(/^"|"$/g, '');
      if (t) msg = t.length > 160 ? t.slice(0, 160) + '…' : t;
    } catch {}
    showToast(msg, 'warning');
  }
  await loadSessions();
};

// Checkbox "aprovar tools sozinho": flag da sessão (default off; nova sessão desmarca).
async function syncAutoApprove(id) {
  const el = document.getElementById('autoApprove');
  if (!el) return;
  try {
    const r = await fetch(`/Chat/Sessions/${id}`);
    if (!r.ok) { el.checked = false; return; }
    const s = await r.json();
    el.checked = !!s.autoApprove;
  } catch { el.checked = false; }
}

document.getElementById('autoApprove')?.addEventListener('change', async (e) => {
  const el = e.target;
  if (!currentSessionId) return;
  try {
    const r = await fetch(`/Chat/Sessions/${currentSessionId}/AutoApprove`, {
      method: 'POST', headers: afHeaders(),
      body: JSON.stringify({ auto: el.checked })
    });
    if (!r.ok) throw new Error('http ' + r.status);
  } catch {
    el.checked = !el.checked;
    showToast('Falha ao salvar aprovação automática.', 'warning');
  }
});

async function checkEngine() {
  try {
    const r = await fetch(`/Chat/Ping?agentId=${agentSel.value}`);
    const j = await r.json();
    engineDot.className = 'dot' + (j.ok ? '' : ' err');
    // Sem interação ainda (conversa vazia): "Pronto!"; com histórico: "Concluído!".
    engineTxt.textContent = !j.ok ? 'Desconectado'
      : (document.getElementById('conv').children.length ? 'Concluído!' : 'Pronto!');
  } catch { engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado'; Tracer.warn('ui:engine', 'ping falhou'); }
}

document.getElementById('newSession').onclick = createSession;

const promptEl = document.getElementById('prompt');
promptEl.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    document.getElementById('send').click();
  }
});

promptEl.addEventListener('blur', () => {
  // Opcional: re-focar após envio (feito no send.onclick)
});

document.getElementById('send').onclick = async () => {
  const ta = document.getElementById('prompt');
  if (!ta.value.trim()) return;
  if (!currentSessionId) {
    // Se não há sessão, tenta criar uma
    await createSession();
    if (!currentSessionId) {
      showToast('Nenhuma sessão disponível. Recarregue a página.', 'warning');
      return;
    }
  }
  const text = ta.value; ta.value = '';

  ta.disabled = true;
  sendBtn.disabled = true;
  sendBtn.innerHTML = 'Enviado';

  // Botão Parar (cancela o processamento); remove resto de envio anterior.
  document.getElementById('cancelBtn')?.remove();
  const cancelBtn = document.createElement('button');
  cancelBtn.type = 'button';
  cancelBtn.className = 'btn btn-sm btn-danger text-black ms-2';
  cancelBtn.id = 'cancelBtn';
  cancelBtn.innerHTML = 'CANCELAR';
  cancelBtn.style.display = 'none';
  sendBtn.parentNode.insertBefore(cancelBtn, sendBtn.nextSibling);
  
  // AbortController for cancellation
  const abortController = new AbortController();
  const sendSessionId = currentSessionId;
  window._streamSession = sendSessionId; window._streamAbort = abortController;
  let stoppedByUser = false;
  cancelBtn.style.display = 'inline-block';
  cancelBtn.onclick = () => {
    stoppedByUser = true;
    // Para o servidor via API + corta o fetch local.
    fetch('/Chat/Stop', { method: 'POST', headers: afHeaders(),
      body: JSON.stringify({ sessionId: sendSessionId }) }).catch(() => {});
    try { abortController.abort(); } catch {}
    window._streamAbort = null; window._streamSession = null;
  window._ensureAgentBubbleForTools = null;
    cancelBtn.style.display = 'none';
    document.getElementById('processing-indicator')?.remove();
    if (anP) anP.classList.remove('typing');
    engineDot.className = 'dot err'; engineTxt.textContent = 'Interrompido';
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    ta.focus();
  };
  
  ta.focus();

  // Adiciona mensagem do usuário na UI imediatamente
  conv.appendChild(msgItem('user', '', esc(text), new Date().toISOString(), undefined, undefined, undefined, 'Enviada'));

  // Indicador "Processando" como linha da conversa (com margem), ativo até finalizar
  const indicator = document.createElement('li');
  indicator.id = 'processing-indicator';
  indicator.className = 'd-flex justify-content-end mt-2 mb-3';
  indicator.innerHTML = '<span class="small text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Processando...</span>';
  conv.appendChild(indicator);
  if (isScrolledToBottom()) scrollToBottom();

  // Prepara bolha do agente (abre no thinking ou no texto real; nunca vazia parada)
  let agentLi = null;
  window._agentBubble = null;
  window._lastSubCard = null;
  window._liveSubs = [];
  let anP = null;
  let think = '';
  let thinkDet = null;
  let thinkP = null;
  let thinkSum = null;
  let thinkLive = false;
  let full = '';
  let agentBubbleCreated = false;

  // Abre a bolha (uma vez) e ancora os sub cards do envio abaixo dela.
  function ensureAgentBubble() {
    if (agentBubbleCreated) return;
    agentLi = document.createElement('li');
    agentLi.className = 'd-flex justify-content-between mb-4';
    agentLi.innerHTML = `
      ${avatarAgent}
      <div class="card w-100">
        <div class="card-header d-flex justify-content-between p-3">
          <p class="fw-bold mb-0">Agente</p>
        </div>
        <div class="card-body">
          <pre class="mb-0 ans rawbox"></pre>
          <div class="msg-ts">${fmtTs(new Date().toISOString())}</div>
        </div>
      </div>`;
    conv.appendChild(agentLi);
    anP = agentLi.querySelector('.ans');
    agentBubbleCreated = true;
    window._agentBubble = agentLi;
    // Ancoragem do grupo Ferramentas quando a tool chega antes do texto.
    window._ensureAgentBubbleForTools = ensureAgentBubble;
    // Pilha do envio: subs acima da bolha, mais recente no topo.
    let anchor = agentLi;
    (window._liveSubs || []).forEach(c => { if (c.isConnected) { anchor.before(c); anchor = c; } });
  }

  // Pintura direta por chunk (o SSE já é progressivo; sem efeito datilográfico).

  engineDot.className = 'dot blink'; engineTxt.textContent = 'Pensando...';

  try {
    const res = await fetch('/Chat/Stream', {
      method: 'POST',
      headers: afHeaders(),
      body: JSON.stringify({ sessionId: currentSessionId, agentId: currentAgentId, messages: [{ role: 'user', content: text }] }), signal: abortController.signal
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    // Parar segue visível durante todo o stream; ENVIAR só volta no fim.
    // (nada de reabilitar aqui: o stream longo precisa do Parar até o done)

    const reader = res.body.getReader(), dec = new TextDecoder();
    let buf = '';
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      if (currentSessionId !== sendSessionId) break;
      buf += dec.decode(value, { stream: true });
      const parts = buf.split('\n\n'); buf = parts.pop();
      for (const p of parts) {
        const line = p.split('\n').find(l => l.startsWith('data:'));
        if (!line || line.includes('[DONE]')) continue;
        try {
          const evt = JSON.parse(line.slice(5));
          if (evt.error) {
            // Falha do servidor no meio do loop: mostra na bolha e segue até o DONE.
            full += '\nErro: ' + evt.error;
            if (!agentBubbleCreated && full.trim()) ensureAgentBubble();
            if (thinkDet) { thinkDet.removeAttribute('open'); if (thinkP) thinkP.classList.remove('typing'); }
            if (anP) { anP.textContent = full; anP.classList.add('typing'); anP.scrollTop = anP.scrollHeight; }
            continue;
          }
          if (evt.progress) {
            // Progresso de tool vindo do servidor (do sub: card próprio).
            if (evt.progress === 'tool_start') {
              if (evt.name === 'subagent' && !evt.sub) { window._currentSubCard = null; }
              else if (!evt.sub) window._currentSubCard = null;
              toolStatus(evt.name, true, null, '', 0, evt.args || '', evt.sub || null);
            }
            else if (evt.progress === 'tool_done') toolStatus(evt.name, false, evt.ok, evt.result || '', evt.ms || 0, '', evt.sub || null);
            else if (evt.progress === 'tool_confirm') toolConfirm(evt.name, evt.result || '', evt.args || '', evt.approveId || 0, evt.label || '');
            else if (evt.progress === 'sub_chunk') subChunk(evt.sub, evt.kind, evt.text || '');
            else if (evt.progress === 'sub_start') subPlaceholder(subPromptOf(evt.args));
            continue;
          }
          const d = evt.choices[0].delta;
          if (d.reasoning_content) {
            // Thinking acumula no MESMO accordion da bolha (fechado, com %; abrir mostra digitando).
            think += d.reasoning_content;
            ensureAgentBubble();
            if (!thinkDet) {
              thinkDet = document.createElement('details');
              thinkDet.className = 'mb-2';
              thinkDet.innerHTML = `<summary class="small text-muted">Raciocínio 0%</summary>`;
              thinkSum = thinkDet.querySelector('summary');
              thinkP = document.createElement('p');
              thinkP.className = 'small text-muted typing';
              thinkDet.appendChild(thinkP);
              insertThinkFirst(thinkDet, anP);
              thinkLive = true;
            }
            if (thinkP) thinkP.classList.add('typing');
            thinkP.textContent = think;
            if (thinkSum) thinkSum.textContent = `Raciocínio ${thinkPct(think.length + full.length)}% · ${fmtK(think.length + full.length)}`;
            thinkP.scrollTop = thinkP.scrollHeight;
            engineTxt.textContent = 'Pensando...';
          }
          else if (d.content) {
            full += d.content;
            // <think> vazado no content: move p/ thinking (some da bolha).
            full = full.replace(/<think>([\s\S]*?)<\/think>/g, (m, t) => { think += t; return ''; });
            { const oi = full.indexOf('<think>'); if (oi >= 0) { think += full.slice(oi + 7); full = full.slice(0, oi); } }
            full = full.split('</think>').join('');
            if (thinkP) thinkP.textContent = think;
            // Sem salto inicial em nenhum caminho (bolha aberta pelo thinking ou pelo texto):
            // enquanto só há espaço, apara a frente; texto real nunca é tocado.
            if (!full.trim()) full = '';
            else full = full.replace(/^\s+/, '');
            // Bolha só quando há texto real (deltas iniciais de espaço não abrem quadro vazio).
            if (!agentBubbleCreated && full.trim()) ensureAgentBubble();
            // Thinking encerrou: o % segue subindo com o conteúdo (chars
            // acumulados) até 100% no DONE — nunca congela. O accordion NÃO é
            // fechado à força (o usuário pode abrir durante o stream).
            if (thinkP) thinkP.classList.remove('typing');
            if (thinkSum) thinkSum.textContent = `Raciocínio ${thinkPct(think.length + full.length)}% · ${fmtK(think.length + full.length)}`;
            if (anP) { anP.textContent = full; anP.classList.add('typing'); anP.scrollTop = anP.scrollHeight; }
          }
        } catch (e) { /* chunk parcial: ignora */ }
      }
      if (isScrolledToBottom()) scrollToBottom();
    }
  } catch (e) {
    if (!stoppedByUser && e?.name !== 'AbortError') Tracer.error('ui:stream', (e && e.message) || e);
    if (stoppedByUser || e?.name === 'AbortError') {
      // Parada pelo usuário: sem bolha de erro nem toast.
      engineTxt.textContent = 'Interrompido';
      ta.disabled = false;
      sendBtn.disabled = false;
      sendBtn.innerHTML = 'ENVIAR';
      if (anP) anP.classList.remove('typing');
      document.getElementById('processing-indicator')?.remove();
      document.getElementById('cancelBtn')?.remove();
      return;
    }
    if (!agentBubbleCreated) {
      // Cria bolha de erro se nem começou
      agentLi = document.createElement('li');
      agentLi.className = 'd-flex justify-content-between mb-4';
      agentLi.innerHTML = `${avatarAgent}<div class="card w-100"><div class="card-body"><p class="mb-0 ans text-danger">Erro: ${esc(e.message)}</p></div></div>`;
      conv.appendChild(agentLi);
    } else {
      anP.textContent = 'Erro: ' + e.message;
    }
    engineDot.className = 'dot err'; engineTxt.textContent = 'Desconectado';
    ta.disabled = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'ENVIAR';
    if (anP) anP.classList.remove('typing');
    document.getElementById('processing-indicator')?.remove();
    document.getElementById('cancelBtn')?.remove();
    showToast('Erro ao conectar na engine. Verifique se a bridge está online.', 'danger');
  }
  window._streamAbort = null; window._streamSession = null;
  window._ensureAgentBubbleForTools = null;
  // Trocou de sessão no meio do stream: não finaliza bolha na conversa errada.
  const stillHere = (currentSessionId === sendSessionId);
  if (agentBubbleCreated && stillHere) {
    // Flush final + thinking fechado em 100% + remove "Processando"
    if (anP) { anP.textContent = full; anP.classList.remove('typing'); }
    if (thinkDet) { thinkDet.removeAttribute('open'); if (thinkP) thinkP.classList.remove('typing'); if (thinkSum) thinkSum.textContent = 'Raciocínio 100%'; }
    else if (thinkLive && anP) {
      // Thinking já exibido ao vivo (accordion aberto e fechado): garante fechado.
      anP.parentNode.querySelectorAll('details').forEach(d => d.removeAttribute('open'));
    }
    if (!thinkLive && think.trim() && anP) {
      const det = document.createElement('details');
      det.className = 'mb-2';
      const sum = document.createElement('summary');
      sum.className = 'small text-muted';
      sum.textContent = 'Raciocínio 100%';
      const p = document.createElement('p');
      p.className = 'small text-muted';
      p.textContent = think;
      det.appendChild(sum);
      det.appendChild(p);
      insertThinkFirst(det, anP);
    }
    document.getElementById('processing-indicator')?.remove();
    engineDot.className = 'dot'; engineTxt.textContent = 'Concluído!';
    thinkNote(think.length + full.length);
  } else if (stillHere) {
    document.getElementById('processing-indicator')?.remove();
  }
  ta.disabled = false;
  sendBtn.disabled = false;
  sendBtn.innerHTML = 'ENVIAR';
  document.getElementById('cancelBtn')?.remove();
  ta.focus();
  // Recarrega do servidor: a bolha ao vivo ganha o rodapé com duração e t/s persistidos.
  if (stillHere) { try { await loadMessages(sendSessionId); await updateCtxDonut(); } catch (e) { Tracer.warn('ui:reload', (e && e.message) || e); } }
  if (stillHere && isScrolledToBottom()) scrollToBottom();
};

// Inicialização - garante sessão ativa antes de permitir envio
let initPromise = (async () => {
  try {
  Tracer.info('ui:init', 'iniciando');
  await loadSessions();
  checkEngine();
  runCalibration();
  if (!currentSessionId) {
    const r = await fetch('/Chat/Sessions');
    const list = await r.json();
    let saved = null;
    try { saved = parseInt(localStorage.getItem('bridgeSessionId') || '', 10) || null; } catch {}
    const hit = saved ? list.find(s => s.id === saved) : null;
    if (hit) {
      await selectSession(hit.id, hit.agentId, hit.executorAgentId);
    } else if (list.length > 0) {
      await selectSession(list[0].id, list[0].agentId, list[0].executorAgentId);
    } else {
      try { localStorage.removeItem('bridgeSessionId'); } catch {}
      await createSession();
    }
  }
  Tracer.info('ui:init', 'ok');
  } catch (e) { Tracer.error('ui:init', (e && e.message) || e); showToast('Falha ao iniciar o chat.', 'danger'); }
})();

// Desabilita send até inicialização completa (mesmo com falha: libera p/ tentar).
const sendBtn = document.getElementById('send');
sendBtn.disabled = true;
initPromise.then(() => { sendBtn.disabled = false; }, () => { sendBtn.disabled = false; });

document.getElementById('newSession').onclick = createSession;
document.getElementById('clearSessions').onclick = deleteAllSessions;
document.getElementById('compactBtn').onclick = async () => {
  if (!currentSessionId) { showToast('Sem sessão ativa.', 'warning'); return; }
  try {
    const r = await fetch(`/Chat/Sessions/${currentSessionId}/Compact`, { method: 'POST', headers: afHeaders() });
    const j = await r.json();
    showToast(j.compacted ? `Compactado: ${j.removed} msgs resumidas.` : 'Nada a compactar.', j.compacted ? 'success' : 'info');
    await loadMessages(currentSessionId);
    updateCtxDonut();
  } catch { showToast('Falha ao compactar.', 'danger'); }
};
</script>
}