<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rochas.OpenCodeBridge.Test — suite unit + e2e da bridge (sem NuGet externo,
    so BCL: HttpClient + System.Text.Json). Runner console: exit 0 PASS, 1 FAIL.
    Uso: dotnet run -c Release (flags: bridge URL, vllm URL, skip-e2e)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rochas.OpenCodeBridge.Test</RootNamespace>
    <AssemblyName>Rochas.OpenCodeBridge.Test</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Suite de testes unit + e2e da bridge Responses para chat-completions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rochas.OpenCodeBridge\Rochas.OpenCodeBridge.csproj" />
  </ItemGroup>

  <!-- Sonda estruturada (Serilog) para persistencia/acompanhamento em tempo real. -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Dados de visão (placa.png/doc.png) vão para o output: Img64 lê de BaseDirectory. -->
  <ItemGroup>
    <None Update="TestData/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
